@model CustomAuthentication.Models.Order

@{
    ViewBag.Title = "Edit Order";
}

<style>
    .eo-glass {
        background: rgba(255,255,255,0.55);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255,255,255,0.6);
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(124,58,237,0.15);
    }
    .eo-title-grad {
        background: linear-gradient(90deg,#3B82F6,#7C3AED);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .eo-btn-ghost {
        border: none; border-radius: 10px; padding: 8px 18px;
        background: linear-gradient(145deg,#ffffff,#EDE9FE); color:#7C3AED; font-weight:600;
        box-shadow: 4px 4px 10px rgba(124,58,237,0.15), -4px -4px 10px rgba(255,255,255,0.9);
    }
    .eo-btn-ghost:hover { color:#7C3AED; text-decoration:none; }
    .eo-btn {
        border: none; border-radius: 10px; padding: 8px 18px;
        background: linear-gradient(90deg,#3B82F6,#7C3AED); color:#fff; font-weight:600;
        box-shadow: 4px 4px 10px rgba(124,58,237,0.25);
    }
    .eo-btn:hover { color:#fff; opacity:.92; text-decoration:none; }
</style>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold eo-title-grad">
                <i class="bi bi-pencil-square me-2"></i>
                Edit Order
            </h2>

            <p style="color:#64748B;">
                Update order information
            </p>

        </div>

        @Html.Partial("_BackBar", new List<CustomAuthentication.ViewModel.BackBarLink>
        {
            new CustomAuthentication.ViewModel.BackBarLink("Dashboard", "Admin", "Dashboard"),
            new CustomAuthentication.ViewModel.BackBarLink("Orders", "Admin", "Orders")
        })

    </div>


    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">

            @Html.ValidationSummary(
                false,
                "",
                new { @class = "mb-0" }
            )

        </div>
    }


    <div class="eo-glass">

        <div class="card-body p-4">

            @using (Html.BeginForm(
                "EditOrder",
                "Admin",
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.OrderId)

                @Html.HiddenFor(m => m.OrderNumber)

                @Html.HiddenFor(m => m.OrderDate)


                <div class="row g-4">

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Customer
                        </label>

                        <select name="UserId"
                                id="UserId"
                                class="form-select"
                                required>

                            <option value="">
                                -- Select Customer --
                            </option>

                            @foreach (var customer in ViewBag.Customers)
                            {
                                <option value="@customer.UserId"
                                        @(customer.UserId == Model.UserId ? "selected" : "")>

                                    @customer.FullName
                                    -
                                    @customer.Email
                                </option>
                            }

                        </select>

                        @Html.ValidationMessageFor(
                            m => m.UserId,
                            "",
                            new { @class = "text-danger" }
                        )
                    </div>


                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Order Number
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.OrderNumber"
                               readonly />

                    </div>


                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Subtotal
                        </label>

                        <input type="text"
                               id="subtotal"
                               class="form-control"
                               value="@Model.OrderItems.Sum(x => x.Quantity * x.UnitPrice).ToString("N2")"
                               readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Discount
                        </label>

                        @Html.TextBoxFor(
                            m => m.Discount,
                            new
                            {
                                @class = "form-control",
                                type = "number",
                                step = "0.01",
                                min = "0",
                                id = "Discount"
                            }
                        )
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Tax
                        </label>

                        @Html.TextBoxFor(
                            m => m.Tax,
                            new
                            {
                                @class = "form-control",
                                type = "number",
                                step = "0.01",
                                min = "0",
                                id = "Tax"
                            }
                        )
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Grand Total
                        </label>

                        <input type="text"
                               id="grandTotal"
                               class="form-control fw-bold"
                               value="@Model.TotalAmount.ToString("N2")"
                               readonly />

                        <small class="text-muted">
                            Subtotal - Discount + Tax
                        </small>
                    </div>


                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Order Status
                        </label>

                        @Html.DropDownListFor(
                            m => m.OrderStatus,
                            new SelectList(
                                new[]
                                {
                                    "Pending",
                                    "Processing",
                                    "Completed",
                                    "Cancelled"
                                },
                                Model.OrderStatus
                            ),
                            new
                            {
                                @class = "form-select"
                            }
                        )

                    </div>


                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Active
                        </label>

                        <div class="form-check form-switch mt-2">

                            @Html.CheckBoxFor(
                                m => m.IsActive,
                                new
                                {
                                    @class = "form-check-input"
                                }
                            )

                            <label class="form-check-label">
                                Active Order
                            </label>

                        </div>

                    </div>


                    <div class="col-12">

                        <hr />

                        <button type="submit"
                                class="eo-btn">

                            <i class="bi bi-save me-1"></i>
                            Update Order

                        </button>

                        <a href="@Url.Action(
                            "Orders",
                            "Admin"
                        )"
                           class="eo-btn-ghost">

                            Cancel

                        </a>

                    </div>

                </div>
            }

        </div>

    </div>

    <script>
    function calculateTotal() {

        var subtotal =
            parseFloat(
                document.getElementById("subtotal").value
            ) || 0;

        var discount =
            parseFloat(
                document.getElementById("Discount").value
            ) || 0;

        var tax =
            parseFloat(
                document.getElementById("Tax").value
            ) || 0;

        if (discount > subtotal) {
            discount = subtotal;

            document.getElementById("Discount").value =
                discount.toFixed(2);
        }

        var total =
            subtotal - discount + tax;

        document.getElementById("grandTotal").value =
            total.toFixed(2);
    }

    document
        .getElementById("Discount")
        .addEventListener("input", calculateTotal);

    document
        .getElementById("Tax")
        .addEventListener("input", calculateTotal);

    calculateTotal();
    </script>
</div>