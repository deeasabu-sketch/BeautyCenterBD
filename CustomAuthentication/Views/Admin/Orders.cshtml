@model IEnumerable<CustomAuthentication.Models.Order>

@{
    ViewBag.Title = "Orders";
    bool canManage = ViewBag.CanManageOrders != null && (bool)ViewBag.CanManageOrders;
}

<style>
    .ord-glass {
        background: rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.6);
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(160, 108, 255, 0.15);
    }
    .ord-neu {
        background: linear-gradient(145deg, #ffffff, #EDE9FE);
        border: none;
        border-radius: 16px;
        box-shadow: 6px 6px 14px rgba(124,58,237,0.15), -6px -6px 14px rgba(255,255,255,0.9);
    }
    .ord-title-grad {
        background: linear-gradient(90deg, #3B82F6, #7C3AED);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .ord-btn {
        border: none;
        border-radius: 10px;
        padding: 8px 16px;
        background: linear-gradient(90deg, #3B82F6, #7C3AED);
        color: #fff;
        font-weight: 600;
        box-shadow: 4px 4px 10px rgba(124,58,237,0.25);
    }
    .ord-btn:hover { color: #fff; opacity: .92; }
    .ord-btn-ghost {
        border: none;
        border-radius: 10px;
        padding: 8px 16px;
        background: linear-gradient(145deg,#ffffff,#EDE9FE);
        color: #7C3AED;
        font-weight: 600;
        box-shadow: 4px 4px 10px rgba(124,58,237,0.15), -4px -4px 10px rgba(255,255,255,0.9);
    }
    .ord-table-wrap {
        max-height: 70vh;
        overflow-y: auto;
        border-radius: 16px;
    }
    .ord-table thead th {
        position: sticky;
        top: 0;
        background: #fff5fa;
        color: #6b3fa0;
        z-index: 1;
    }
    .ord-table tbody tr:hover { background: rgba(124,58,237,0.06); }
    .ord-icon-btn {
        width: 34px; height: 34px;
        border-radius: 10px;
        display: inline-flex; align-items: center; justify-content: center;
        border: none;
        background: linear-gradient(145deg,#ffffff,#EDE9FE);
        box-shadow: 3px 3px 8px rgba(124,58,237,0.15), -3px -3px 8px rgba(255,255,255,0.9);
        color: #7C3AED;
        margin: 0 2px;
    }
    .ord-icon-btn.danger { color: #3B82F6; }
    #ordScrollTopBtn {
        position: absolute;
        bottom: 14px;
        right: 14px;
        width: 40px; height: 40px;
        border: none;
        border-radius: 50%;
        background: linear-gradient(145deg,#ffffff,#EDE9FE);
        box-shadow: 4px 4px 10px rgba(124,58,237,0.2), -4px -4px 10px rgba(255,255,255,0.9);
        color: #7C3AED;
        display: none;
    }
    /* ================================
   ORDER STATUS DROPDOWN
   ================================ */

    .order-status-form {
        display: inline-block;
        margin: 0;
    }

    .order-status-select {
        min-width: 125px;
        height: 34px;
        padding: 4px 28px 4px 10px;
        border: 1px solid rgba(124, 58, 237, 0.20);
        border-radius: 9px;
        background: linear-gradient(145deg, #ffffff, #F3EEFF);
        color: #5B21B6;
        font-size: 13px;
        font-weight: 600;
        outline: none;
        cursor: pointer;
        box-shadow: 3px 3px 8px rgba(124,58,237,0.10), -3px -3px 8px rgba(255,255,255,0.90);
        transition: all 0.2s ease;
    }

        .order-status-select:hover {
            border-color: rgba(124, 58, 237, 0.45);
            transform: translateY(-1px);
        }

        .order-status-select:focus {
            border-color: #7C3AED;
            box-shadow: 0 0 0 3px rgba(124,58,237,0.12), 3px 3px 8px rgba(124,58,237,0.10);
        }

        .order-status-select option {
            background: #ffffff;
            color: #24324A;
            font-weight: 600;
        }

            /* Status colors */

            .order-status-select option[value="Pending"] {
                color: #B45309;
            }

            .order-status-select option[value="Processing"] {
                color: #6D28D9;
            }

            .order-status-select option[value="Completed"] {
                color: #15803D;
            }

            .order-status-select option[value="Cancelled"] {
                color: #DC2626;
            }
</style>

<div class="py-2">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1 ord-title-grad"><i class="bi bi-cart-check me-2"></i>Orders</h2>
            <p class="mb-0" style="color:#64748B;">
                @if (canManage)
                {
                    <text>Manage all customer orders</text>
                }
                else
                {
                    <text>Viewing orders (read-only access)</text>
                }
            </p>
        </div>

        <div class="d-flex gap-2">
            @if (canManage)
            {
                <a href="@Url.Action("AddOrder", "Admin")" class="ord-btn"><i class="bi bi-plus-circle me-1"></i> Add Order</a>
            }
            <a href="javascript:history.back()" class="ord-btn-ghost"><i class="bi bi-arrow-left me-1"></i> Back</a>
        </div>
    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }


    <!-- Statistics -->
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="graph-btn" data-graph="orders" data-title="Orders (last 6 months)">
            <i class="bi bi-bar-chart-fill"></i> Graph
        </button>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="ord-neu p-3 d-flex justify-content-between align-items-center">
                <div>
                    <h6 style="color:#64748B;">Total Orders</h6>
                    <h3 class="fw-bold mb-0">@Model.Count()</h3>
                </div>
                <div class="fs-2" style="color:#7C3AED;"><i class="bi bi-cart-check"></i></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="ord-neu p-3 d-flex justify-content-between align-items-center">
                <div>
                    <h6 style="color:#64748B;">Total Amount</h6>
                    <h3 class="fw-bold mb-0">Taka @Model.Sum(x => x.TotalAmount).ToString("N2")</h3>
                </div>
                <div class="fs-2" style="color:#3B82F6;"><i class="bi bi-cash-stack"></i></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="ord-neu p-3 d-flex justify-content-between align-items-center">
                <div>
                    <h6 style="color:#64748B;">Completed Orders</h6>
                    <h3 class="fw-bold mb-0">@Model.Count(x => x.OrderStatus == "Completed")</h3>
                </div>
                <div class="fs-2" style="color:#6bcf7f;"><i class="bi bi-check2-circle"></i></div>
            </div>
        </div>
    </div>


    <!-- Orders Table (line-by-line, scrollable) -->
    <div class="ord-glass p-3 position-relative">

        <div class="d-flex justify-content-between align-items-center mb-2 px-2">
            <h5 class="fw-bold mb-0" style="color:#24324A;">
                All Orders
            </h5>

            <span style="color:#64748B;font-size:.85rem;">
                @Model.Count() total
            </span>
        </div>

        <div class="ord-table-wrap" id="ordTableWrap">

            <table class="table table-hover align-middle mb-0 ord-table">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>Order Number</th>
                        <th>User ID</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Order Date</th>

                        @if (canManage)
                        {
                            <th class="text-end">Action</th>
                        }
                        else
                        {
                            <th class="text-end">Details</th>
                        }
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        int serial = 1;

                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- Serial -->
                                <td>
                                    @serial
                                </td>

                                <!-- Order Number -->
                                <td>
                                    <strong>@item.OrderNumber</strong>
                                </td>

                                <!-- User ID -->
                                <td>
                                    @item.UserId
                                </td>

                                <!-- Amount -->
                                <td>
                                    <strong>
                                        Taka @item.TotalAmount.ToString("N2")
                                    </strong>
                                </td>

                                <!-- Status -->
                                <td>

                                    <form action="@Url.Action("UpdateOrderStatus", "Admin")"
                                          method="post"
                                          class="order-status-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.OrderId" />

                                        <select name="status"
                                                class="order-status-select"
                                                onchange="this.form.submit()"
                                                title="Change Order Status">

                                            <option value="Pending"
                                                    @(item.OrderStatus == "Pending" ? "selected" : "")>
                                                Pending
                                            </option>

                                            <option value="Processing"
                                                    @(item.OrderStatus == "Processing" ? "selected" : "")>
                                                Processing
                                            </option>

                                            <option value="Completed"
                                                    @(item.OrderStatus == "Completed" ? "selected" : "")>
                                                Completed
                                            </option>

                                            <option value="Cancelled"
                                                    @(item.OrderStatus == "Cancelled" ? "selected" : "")>
                                                Cancelled
                                            </option>

                                        </select>

                                    </form>

                                </td>

                                <!-- Order Date -->
                                <td>
                                    @item.OrderDate.ToString("dd MMM yyyy hh:mm tt")
                                </td>

                                <!-- Action -->
                                <td class="text-end">

                                    <!-- Order Details -->
                                    <a href="@Url.Action("OrderDetails", "Admin", new { id = item.OrderId })"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-eye me-1"></i>
                                        Order Details

                                    </a>


                                    <!-- Invoice -->
                                    <a href="@Url.Action("Invoice", "Admin", new { id = item.OrderId })"
                                       target="_blank"
                                       class="btn btn-sm btn-primary">

                                        <i class="bi bi-receipt me-1"></i>
                                        Invoice

                                    </a>


                                    @if (canManage)
                                    {
                                        <!-- Edit -->
                                        <a href="@Url.Action("EditOrder", "Admin", new { id = item.OrderId })"
                                           class="ord-icon-btn"
                                           title="Edit">

                                            <i class="bi bi-pencil"></i>

                                        </a>


                                        <!-- Delete -->
                                        <form action="@Url.Action("DeleteOrder", "Admin")"
                                              method="post"
                                              style="display:inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.OrderId" />

                                            <button type="submit"
                                                    class="ord-icon-btn danger"
                                                    onclick="return confirm('Are you sure you want to delete this order?');"
                                                    title="Delete">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </form>
                                    }

                                </td>

                            </tr>

                            serial++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center py-5">

                                <div style="color:#64748B;">

                                    <i class="bi bi-cart-x fs-1 d-block mb-3"></i>

                                    <h5>No Orders Found</h5>

                                    <p>
                                        There are currently no orders.
                                    </p>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- Scroll To Top -->
        <button id="ordScrollTopBtn"
                title="Scroll to top">

            <i class="bi bi-arrow-up"></i>

        </button>

    </div>
    


    <script>
        (function () {
            var wrap = document.getElementById("ordTableWrap");
            var btn = document.getElementById("ordScrollTopBtn");

            if (wrap === null || btn === null) {
                return;
            }

            wrap.addEventListener("scroll", function () {
                btn.style.display = wrap.scrollTop > 150 ? "inline-flex" : "none";
            });

            btn.addEventListener("click", function () {
                wrap.scrollTop = 0;
            });
        })();
    </script>

    @Html.Partial("_GraphModal")
