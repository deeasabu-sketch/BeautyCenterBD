`
@model IEnumerable<CustomAuthentication.Models.User>

@{
    ViewBag.Title = "Manage Users";
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>
                Manage Users
            </h2>

            <p class="text-muted mb-0">
                View and manage all registered users.
            </p>
        </div>

        <div class="d-flex gap-2">

            <!-- Dashboard -->
            <a href="@Url.Action("Dashboard", "Admin")"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Dashboard
            </a>

            <!-- Add User -->
            <a href="@Url.Action("AddUser", "Admin")"
               class="btn btn-primary">
                <i class="bi bi-person-plus-fill me-1"></i>
                Add User
            </a>

        </div>

    </div>


    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <!-- Users Table -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th class="px-4">#</th>
                            <th>User</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th class="text-center">Actions</th>
                        </tr>

                    </thead>


                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center py-5 text-muted">

                                    <i class="bi bi-people fs-1 d-block mb-2"></i>

                                    No users found.

                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <!-- User ID -->
                                    <td class="px-4 fw-bold">
                                        @item.UserId
                                    </td>


                                    <!-- User -->
                                    <td>
                                        <div class="d-flex align-items-center">

                                            <div class="user-avatar">
                                                @(string.IsNullOrEmpty(item.FullName)
                                                    ? "?"
                                                    : item.FullName.Substring(0, 1).ToUpper())
                                            </div>

                                            <div class="ms-3">
                                                <div class="fw-semibold">
                                                    @item.FullName
                                                </div>
                                            </div>

                                        </div>
                                    </td>


                                    <!-- Email -->
                                    <td>
                                        @item.Email
                                    </td>


                                    <!-- Role -->
                                    <td>

                                        @if (item.RoleName == "Admin")
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-shield-fill-check me-1"></i>
                                                Admin
                                            </span>
                                        }
                                        else if (item.RoleName == "Employee")
                                        {
                                            <span class="badge bg-primary">
                                                Employee
                                            </span>
                                        }
                                        else if (item.RoleName == "Accountant")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Accountant
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Customer
                                            </span>
                                        }

                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }

                                    </td>


                                    <!-- Created -->
                                    <td>
                                        @item.CreateDate.ToString("dd MMM yyyy hh:mm tt")
                                    </td>


                                    <!-- Actions -->
                                    <td class="text-center">

                                        <div class="d-flex justify-content-center gap-2">

                                            <!-- Edit -->
                                            <a href="@Url.Action("Edit", "User", new { id = item.UserId })"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit User">

                                                <i class="bi bi-pencil-square"></i>

                                            </a>


                                            <!-- Status -->
                                            @using (Html.BeginForm(
                                                "ToggleStatus",
                                                "Admin",
                                                FormMethod.Post,
                                                new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.UserId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success"
                                                        title="Change Status">

                                                    <i class="bi bi-power"></i>

                                                </button>
                                            }


                                            <!-- Delete -->
                                            @using (Html.BeginForm(
                                                "DeleteUser",
                                                "Admin",
                                                FormMethod.Post,
                                                new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.UserId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Delete"
                                                        onclick="return confirm('Are you sure you want to delete this user?');">

                                                    <i class="bi bi-trash-fill"></i>

                                                </button>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<style>

    .user-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #dbeafe;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .table > :not(caption) > * > * {
        padding-top: 14px;
        padding-bottom: 14px;
    }
</style>

