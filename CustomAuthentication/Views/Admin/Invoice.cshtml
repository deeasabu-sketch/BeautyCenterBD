@model CustomAuthentication.Models.Order

@{
    Layout = null;

    ViewBag.Title = "Invoice";

    decimal subtotal = 0;

    if (Model.OrderItems != null)
    {
        subtotal = Model.OrderItems.Sum(x => x.Quantity * x.UnitPrice);
    }

    decimal discountAmount = Model.Discount;
    decimal taxAmount = Model.Tax;
    decimal grandTotal = subtotal - discountAmount + taxAmount;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Invoice - @Model.OrderNumber | BeautyCenter BD</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bc-primary-soft: #3B82F6;
            --bc-purple: #7C3AED;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            padding: 30px;
            background: linear-gradient(135deg, #F0F9FF 0%, #EDE9FE 100%);
            font-family: 'Poppins', Arial, sans-serif;
            color: #3a2e46;
        }

        .invoice-container {
            width: 210mm;
            min-height: 297mm;
            margin: auto;
            background: rgba(255,255,255,0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255,255,255,0.7);
            border-radius: 22px;
            padding: 34px 40px;
            box-shadow: 0 12px 40px rgba(124,58,237,0.2);
        }

        /* ===== Header ===== */
        .invoice-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding-bottom: 22px;
            margin-bottom: 26px;
            border-bottom: 2px solid rgba(124,58,237,0.25);
        }

        .brand-row {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-logo {
            width: 52px; height: 52px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--bc-primary-soft), var(--bc-purple));
            display: flex; align-items: center; justify-content: center;
            color: #fff;
            font-size: 1.6rem;
            box-shadow: 4px 4px 12px rgba(124,58,237,0.3);
            flex-shrink: 0;
        }

        .company-name {
            font-size: 26px;
            font-weight: 800;
            line-height: 1.1;
            background: linear-gradient(90deg, var(--bc-primary-soft), var(--bc-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .company-tag {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .5px;
            color: #7C3AED;
            text-transform: uppercase;
        }

        .company-info {
            color: #64748B;
            font-size: 12.5px;
            line-height: 1.7;
            margin-top: 10px;
        }

        .invoice-title {
            text-align: right;
        }

        .invoice-title h1 {
            margin: 0;
            font-size: 32px;
            letter-spacing: 3px;
            font-weight: 800;
            color: #3a2e46;
        }

        .invoice-badge {
            display: inline-block;
            margin-top: 6px;
            padding: 4px 14px;
            border-radius: 20px;
            background: linear-gradient(90deg, var(--bc-primary-soft), var(--bc-purple));
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .5px;
        }

        .invoice-number {
            margin-top: 10px;
            font-size: 13px;
            color: #64748B;
        }

        .invoice-number strong { color: #3a2e46; }

        /* ===== Info Section ===== */
        .info-section {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 28px;
        }

        .info-box {
            width: 48%;
            background: rgba(255,255,255,0.55);
            border: 1px solid rgba(255,255,255,0.7);
            border-radius: 16px;
            padding: 16px 18px;
        }

        .info-title {
            font-size: 11px;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: .5px;
            color: var(--bc-purple);
            margin-bottom: 10px;
        }

        .info-value {
            font-size: 13.5px;
            line-height: 1.9;
            color: #3a2e46;
        }

        .status-pill {
            display: inline-block;
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
        }
        .status-completed { background: #d7f5e3; color: #1d8a4c; }
        .status-processing { background: linear-gradient(90deg, var(--bc-primary-soft), var(--bc-purple)); color: #fff; }
        .status-cancelled { background: #fde1e1; color: #c0392b; }
        .status-pending { background: #fff3cd; color: #8a6d1d; }

        /* ===== Table ===== */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 6px;
            border-radius: 14px;
            overflow: hidden;
        }

        thead {
            background: linear-gradient(90deg, var(--bc-primary-soft), var(--bc-purple));
            color: white;
        }

        th {
            padding: 12px 10px;
            font-size: 12.5px;
            text-align: left;
            font-weight: 600;
        }

        td {
            padding: 11px 10px;
            border-bottom: 1px solid rgba(124,58,237,0.15);
            font-size: 13px;
            background: rgba(255,255,255,0.4);
        }

        tbody tr:nth-child(even) td { background: rgba(255,255,255,0.6); }

        .text-center { text-align: center; }
        .text-right { text-align: right; }

        .product-name { font-weight: 600; color: #3a2e46; }

        .empty-items {
            text-align: center;
            padding: 25px;
            color: #64748B;
            background: rgba(255,255,255,0.4);
        }

        /* ===== Summary ===== */
        .summary {
            width: 330px;
            margin-left: auto;
            margin-top: 26px;
            background: rgba(255,255,255,0.55);
            border: 1px solid rgba(255,255,255,0.7);
            border-radius: 16px;
            padding: 18px 20px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            font-size: 13.5px;
            color: #24324A;
        }

        .summary-row.discount-row span:last-child { color: #3B82F6; font-weight: 600; }
        .summary-row.tax-row span:last-child { color: #7C3AED; font-weight: 600; }

        .summary-total {
            border-top: 2px solid rgba(124,58,237,0.3);
            margin-top: 8px;
            padding-top: 12px;
            font-size: 19px;
            font-weight: 800;
            color: #3a2e46;
        }

        /* ===== Footer ===== */
        .footer {
            margin-top: 60px;
            padding-top: 16px;
            border-top: 1px solid rgba(124,58,237,0.2);
            text-align: center;
            color: #64748B;
            font-size: 12px;
            line-height: 1.7;
        }
        .footer strong { color: #7C3AED; }

        /* ===== Action buttons ===== */
        .action-buttons {
            width: 210mm;
            margin: 0 auto 20px auto;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .btn {
            border: none;
            padding: 10px 20px;
            cursor: pointer;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            font-family: 'Poppins', sans-serif;
        }

        .btn-print {
            background: linear-gradient(90deg, var(--bc-primary-soft), var(--bc-purple));
            color: white;
            box-shadow: 4px 4px 12px rgba(124,58,237,0.3);
        }

        .btn-back {
            background: linear-gradient(145deg, #ffffff, #EDE9FE);
            color: var(--bc-purple);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            box-shadow: 4px 4px 12px rgba(124,58,237,0.15);
        }

        @@media print {
            body {
                background: white;
                padding: 0;
            }

            .invoice-container {
                width: 100%;
                min-height: auto;
                box-shadow: none;
                border: none;
                border-radius: 0;
                padding: 15mm;
                backdrop-filter: none;
                background: white;
            }

            .action-buttons { display: none; }

            @@page {
                size: A4;
                margin: 0;
            }
        }
    </style>
</head>

<body>

    <div class="action-buttons">
        <button type="button" class="btn btn-print" onclick="window.print();">
            <i class="bi bi-printer-fill"></i> Print Invoice
        </button>

        <a href="@Url.Action("OrderDetails", "Admin", new { id = Model.OrderId })" class="btn btn-back">
            <i class="bi bi-arrow-left me-1"></i> Back to Order Details
        </a>
    </div>


    <div class="invoice-container">

        <!-- HEADER -->
        <div class="invoice-header">

            <div class="brand-row">
                <div class="brand-logo"><i class="bi bi-flower2"></i></div>
                <div>
                    <div class="company-name">BeautyCenter <span style="-webkit-text-fill-color:#3a2e46;">BD</span></div>
                    <div class="company-tag">Cosmetics Wholesale</div>
                    <div class="company-info">
                        Dhaka, Bangladesh<br />
                        Phone: +880 1XXX-XXXXXX<br />
                        Email: info@beautycenterbd.com
                    </div>
                </div>
            </div>

            <div class="invoice-title">
                <h1>INVOICE</h1>
                <span class="invoice-badge">Official Receipt</span>

                <div class="invoice-number">
                    <strong>Order No:</strong> @Model.OrderNumber
                </div>
                <div class="invoice-number">
                    <strong>Date:</strong> @Model.OrderDate.ToString("dd MMM yyyy")
                </div>
            </div>

        </div>


        <!-- CUSTOMER / ORDER INFO -->
        <div class="info-section">

            <div class="info-box">
                <div class="info-title"><i class="bi bi-person-circle me-1"></i>Bill To</div>
                <div class="info-value">
                    <strong>@ViewBag.CustomerName</strong><br />
                    <i class="bi bi-telephone me-1"></i>@ViewBag.CustomerPhone<br />
                    <i class="bi bi-envelope me-1"></i>@ViewBag.CustomerEmail<br />
                    <i class="bi bi-geo-alt me-1"></i>@ViewBag.CustomerAddress
                </div>
            </div>

            <div class="info-box">
                <div class="info-title"><i class="bi bi-receipt me-1"></i>Order Information</div>
                <div class="info-value">
                    <strong>Order ID:</strong> #@Model.OrderId<br />
                    <strong>Order Date:</strong> @Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")<br />
                    <strong>Status:</strong>
                    @{
                        string statusClass = "status-pending";
                        if (Model.OrderStatus == "Completed") { statusClass = "status-completed"; }
                        else if (Model.OrderStatus == "Processing") { statusClass = "status-processing"; }
                        else if (Model.OrderStatus == "Cancelled") { statusClass = "status-cancelled"; }
                    }
                    <span class="status-pill @statusClass">@Model.OrderStatus</span>
                </div>
            </div>

        </div>


        <!-- PRODUCTS -->
        <table>
            <thead>
                <tr>
                    <th style="width: 8%;">#</th>
                    <th style="width: 42%;">Product</th>
                    <th style="width: 15%;" class="text-center">Qty</th>
                    <th style="width: 17%;" class="text-right">Unit Price</th>
                    <th style="width: 18%;" class="text-right">Total</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.OrderItems != null && Model.OrderItems.Any())
                {
                    int serial = 1;
                    foreach (var item in Model.OrderItems)
                    {
                        decimal itemTotal = item.Quantity * item.UnitPrice;
                        <tr>
                            <td>@serial</td>
                            <td class="product-name">@(item.Product != null ? item.Product.ProductName : "Product")</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-right">Taka @item.UnitPrice.ToString("N2")</td>
                            <td class="text-right">Taka @itemTotal.ToString("N2")</td>
                        </tr>
                        serial++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="empty-items">No products found for this order.</td>
                    </tr>
                }
            </tbody>
        </table>


        <!-- SUMMARY -->
        <div class="summary">
            <div class="summary-row">
                <span>Subtotal</span>
                <span>Taka @subtotal.ToString("N2")</span>
            </div>

            <div class="summary-row discount-row">
                <span><i class="bi bi-tag-fill me-1"></i>Discount</span>
                <span>- Taka @discountAmount.ToString("N2")</span>
            </div>

            <div class="summary-row tax-row">
                <span><i class="bi bi-receipt-cutoff me-1"></i>Tax / VAT</span>
                <span>+ Taka @taxAmount.ToString("N2")</span>
            </div>

            <div class="summary-row summary-total">
                <span>Grand Total</span>
                <span>Taka @grandTotal.ToString("N2")</span>
            </div>
        </div>


        <!-- FOOTER -->
        <div class="footer">
            <strong>Thank you for shopping with BeautyCenter BD!</strong><br />
            This is a computer generated invoice and does not require a signature.
        </div>

    </div>

</body>
</html>
