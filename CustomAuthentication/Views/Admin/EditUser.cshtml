
@model CustomAuthentication.ViewModel.AdminUserViewModel

@{
    ViewBag.Title = "Edit User";
}

<div class="container mt-4 mb-5">

    <!-- Back Button -->
    <div class="mb-3">
        @Html.Partial("_BackBar", new List<CustomAuthentication.ViewModel.BackBarLink>
        {
            new CustomAuthentication.ViewModel.BackBarLink("Dashboard", "Admin", "Dashboard"),
            new CustomAuthentication.ViewModel.BackBarLink("Manage Users", "Admin", "ManageUsers")
        })
    </div>


    <!-- Edit User Card -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                <i class="bi bi-person-gear me-2"></i>
                Edit User
            </h4>
        </div>


        <div class="card-body p-4">

            <!-- Validation Summary -->
            @Html.ValidationSummary(
                true,
                "",
                new { @class = "alert alert-danger" }
            )


            @using (Html.BeginForm(
                "EditUser",
                "Admin",
                FormMethod.Post,
                new { @class = "row g-3" }))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.UserId)


                <!-- Full Name -->
                <div class="col-md-6">

                    @Html.LabelFor(
                        m => m.FullName,
                        new { @class = "form-label fw-semibold" })

                    @Html.TextBoxFor(
                        m => m.FullName,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Enter full name"
                        })

                    @Html.ValidationMessageFor(
                        m => m.FullName,
                        "",
                        new { @class = "text-danger" })

                </div>


                <!-- Email -->
                <div class="col-md-6">

                    @Html.LabelFor(
                        m => m.Email,
                        new { @class = "form-label fw-semibold" })

                    @Html.TextBoxFor(
                        m => m.Email,
                        new
                        {
                            @class = "form-control",
                            type = "email",
                            placeholder = "Enter email address"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Email,
                        "",
                        new { @class = "text-danger" })

                </div>


                <!-- Password -->
                <div class="col-md-6">

                    @Html.LabelFor(
                        m => m.Password,
                        new { @class = "form-label fw-semibold" })

                    @Html.PasswordFor(
                        m => m.Password,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Leave blank to keep current password"
                        })

                    <small class="text-muted">
                        Leave blank if you don't want to change the password.
                    </small>

                    @Html.ValidationMessageFor(
                        m => m.Password,
                        "",
                        new { @class = "text-danger" })

                </div>


                <!-- Confirm Password -->
                <div class="col-md-6">

                    @Html.LabelFor(
                        m => m.ConfirmPassword,
                        new { @class = "form-label fw-semibold" })

                    @Html.PasswordFor(
                        m => m.ConfirmPassword,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Confirm new password"
                        })

                    @Html.ValidationMessageFor(
                        m => m.ConfirmPassword,
                        "",
                        new { @class = "text-danger" })

                </div>


                <!-- Role -->
                <div class="col-md-6">

                    @Html.LabelFor(
                        m => m.RoleName,
                        new { @class = "form-label fw-semibold" })

                    @Html.DropDownListFor(
                        m => m.RoleName,
                        (SelectList)ViewBag.Roles,
                        "Select Role",
                        new { @class = "form-select" })

                    @Html.ValidationMessageFor(
                        m => m.RoleName,
                        "",
                        new { @class = "text-danger" })

                </div>


                <!-- Status -->
                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Account Status
                    </label>

                    <div class="form-check mt-2">

                        @Html.CheckBoxFor(
                            m => m.IsActive,
                            new { @class = "form-check-input" })

                        <label class="form-check-label">
                            Active
                        </label>

                    </div>

                </div>
                <!-- ========================= -->
                <!-- USER PERMISSIONS -->
                <!-- ========================= -->

                <div class="col-12 mt-4">

                    <div class="card border shadow-sm">

                        <div class="card-header bg-light">

                            <h5 class="mb-0">
                                <i class="bi bi-shield-check me-2"></i>
                                User Permissions
                            </h5>

                            <small class="text-muted">
                                Select what this user is allowed to do.
                            </small>

                        </div>


                        <div class="card-body">

                            <div class="row g-4">


                                <!-- Dashboard -->
                                <div class="col-md-6">

                                    <h6 class="fw-bold border-bottom pb-2">
                                        Dashboard
                                    </h6>

                                    <div class="form-check">
                                        @Html.CheckBoxFor(
                                            m => m.CanViewDashboard,
                                            new { @class = "form-check-input" })

                                        <label class="form-check-label">
                                            View Dashboard
                                        </label>
                                    </div>

                                </div>


                                <!-- Products -->
                                <div class="col-md-6">

                                    <h6 class="fw-bold border-bottom pb-2">
                                        Products
                                    </h6>

                                    <div class="form-check">
                                        @Html.CheckBoxFor(
                                            m => m.CanViewProducts,
                                            new { @class = "form-check-input" })

                                        <label class="form-check-label">
                                            View Products
                                        </label>
                                    </div>

                                    <div class="form-check">
                                        @Html.CheckBoxFor(
                                            m => m.CanAddProducts,
                                            new { @class = "form-check-input" })

                                        <label class="form-check-label">
                                            Add Products
                                        </label>
                                    </div>

                                    <div class="form-check">
                                        @Html.CheckBoxFor(
                                            m => m.CanEditProducts,
                                            new { @class = "form-check-input" })

                                        <label class="form-check-label">
                                            Edit Products
                                        </label>
                                    </div>

                                    <div class="form-check">
                                        @Html.CheckBoxFor(
                                            m => m.CanDeleteProducts,
                                            new { @class = "form-check-input" })

                                        <label class="form-check-label">
                                            Delete Products
                                        </label>
                                    </div>

                                </div>


                                <!-- Orders -->
                                <div class="col-md-6">

                                    <h6 class="fw-bold border-bottom pb-2">
                                        Orders
                                    </h6>

                                    <div class="form-check">
                                        @Html.CheckBoxFor(
                                            m => m.CanViewOrders,
                                            new { @class = "form-check-input" })

                                        <label class="form-check-label">
                                            View Orders
                                        </label>
                                    </div>

                                    <div class="form-check">
                                        @Html.CheckBoxFor(
                                            m => m.CanAddOrders,
                                            new { @class = "form-check-input" })

                                        <label class="form-check-label">
                                            Add Orders
                                        </label>
                                    </div>

                                    <div class="form-check">
                                        @Html.CheckBoxFor(
                                            m => m.CanEditOrders,
                                            new { @class = "form-check-input" })

                                        <label class="form-check-label">
                                            Edit Orders
                                        </label>
                                    </div>

                                    <div class="form-check">
                                        @Html.CheckBoxFor(
                                            m => m.CanDeleteOrders,
                                            new { @class = "form-check-input" })

                                        <label class="form-check-label">
                                            Delete Orders
                                        </label>
                                    </div>

                                </div>


                                <!-- Reports -->
                                <div class="col-md-6">

                                    <h6 class="fw-bold border-bottom pb-2">
                                        Reports
                                    </h6>

                                    <div class="form-check">
                                        @Html.CheckBoxFor(
                                            m => m.CanViewReports,
                                            new { @class = "form-check-input" })

                                        <label class="form-check-label">
                                            View Reports
                                        </label>
                                    </div>

                                </div>


                                <!-- User Management -->
                                <div class="col-md-6">

                                    <h6 class="fw-bold border-bottom pb-2">
                                        User Management
                                    </h6>

                                    <div class="form-check">
                                        @Html.CheckBoxFor(
                                            m => m.CanManageUsers,
                                            new { @class = "form-check-input" })

                                        <label class="form-check-label">
                                            Manage Users
                                        </label>
                                    </div>

                                </div>


                                <!-- Notebook -->
                                <div class="col-md-6">

                                    <h6 class="fw-bold border-bottom pb-2">
                                        Notebook
                                    </h6>

                                    <div class="form-check">

                                        @Html.CheckBoxFor(
                                            m => m.CanViewNotebook,
                                            new { @class = "form-check-input" })

                                        <label class="form-check-label">
                                            View Notebook
                                        </label>

                                    </div>

                                    <div class="form-check">

                                        @Html.CheckBoxFor(
                                            m => m.CanAddNotebook,
                                            new { @class = "form-check-input" })

                                        <label class="form-check-label">
                                            Add Notebook
                                        </label>

                                    </div>

                                    <div class="form-check">

                                        @Html.CheckBoxFor(
                                            m => m.CanEditNotebook,
                                            new { @class = "form-check-input" })

                                        <label class="form-check-label">
                                            Edit Notebook
                                        </label>

                                    </div>

                                    <div class="form-check">

                                        @Html.CheckBoxFor(
                                            m => m.CanDeleteNotebook,
                                            new { @class = "form-check-input" })

                                        <label class="form-check-label">
                                            Delete Notebook
                                        </label>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Buttons -->
                <div class="col-12 mt-4">

                    <hr />

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-save me-1"></i>
                            Update User

                        </button>


                        <a href="@Url.Action("ManageUsers", "Admin")"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-x-circle me-1"></i>
                            Cancel

                        </a>

                    </div>

                </div>

            }

        </div>

    </div>

</div>

