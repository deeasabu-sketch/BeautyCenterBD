@model CustomAuthentication.ViewModel.PermissionMatrixViewModel
@{ ViewBag.Title = "Permissions"; }
<style>
.glass-card{background:rgba(255,255,255,.55);backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.6);border-radius:20px;box-shadow:0 8px 32px rgba(124,58,237,.15);}
.title-grad{background:linear-gradient(90deg,#3B82F6,#7C3AED);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.btn-glass{border:none;border-radius:10px;padding:8px 18px;background:linear-gradient(90deg,#3B82F6,#7C3AED);color:#fff;font-weight:600;}
.btn-ghost{border:none;border-radius:10px;padding:8px 18px;background:linear-gradient(145deg,#ffffff,#EDE9FE);color:#7C3AED;font-weight:600;}
.btn-ghost:hover{color:#7C3AED;text-decoration:none;}
.role-header{background:linear-gradient(90deg,#3B82F6,#7C3AED);color:#fff;}
</style>
<div class="container-fluid py-5 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h2 class="fw-bold mb-1 title-grad"><i class="bi bi-shield-lock me-2"></i>Role Permissions</h2><p class="mb-0" style="color:#64748B;">Decide what each role can view / create / edit / delete</p></div>
        <a href="@Url.Action("Dashboard","Admin")" class="btn-ghost"><i class="bi bi-arrow-left me-1"></i>Dashboard</a>
    </div>
    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

    @using (Html.BeginForm("Save", "Permission", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        int i = 0;
        foreach (var role in Model.Roles)
        {
            <div class="glass-card mb-4">
                <div class="role-header px-4 py-2 rounded-top" style="border-radius:20px 20px 0 0 !important;"><h5 class="mb-0 py-1"><i class="bi bi-person-badge me-2"></i>@role</h5></div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th class="ps-4">Module</th><th class="text-center">View</th><th class="text-center">Create</th><th class="text-center">Edit</th><th class="text-center">Delete</th></tr></thead>
                        <tbody>
                        @foreach (var row in Model.Rows.Where(r => r.RoleName == role))
                        {
                            <tr>
                                @Html.Hidden("Rows[" + i + "].RoleName", row.RoleName)
                                @Html.Hidden("Rows[" + i + "].ModuleId", row.ModuleId)
                                <td class="ps-4 fw-semibold" style="color:#24324A;">@row.ModuleName</td>
                                <td class="text-center"><input type="checkbox" name="Rows[@i].CanView" value="true" @(row.CanView ? "checked" : "") /></td>
                                <td class="text-center"><input type="checkbox" name="Rows[@i].CanCreate" value="true" @(row.CanCreate ? "checked" : "") /></td>
                                <td class="text-center"><input type="checkbox" name="Rows[@i].CanEdit" value="true" @(row.CanEdit ? "checked" : "") /></td>
                                <td class="text-center"><input type="checkbox" name="Rows[@i].CanDelete" value="true" @(row.CanDelete ? "checked" : "") /></td>
                            </tr>
                            i++;
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        <button type="submit" class="btn-glass"><i class="bi bi-check-circle me-1"></i>Save Permissions</button>
    }
</div>
