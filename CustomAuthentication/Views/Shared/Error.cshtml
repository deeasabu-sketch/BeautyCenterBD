@{
    ViewBag.Title = "Something went wrong";
    var requestId = HttpContext.Current != null ? HttpContext.Current.TraceIdentifier : null;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="glass-card p-4 p-md-5 text-center">
                <div class="mb-3" style="font-size:3rem;color:#EF4444;">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <h1 class="h3 fw-bold mb-2">We couldn't complete that request</h1>
                <p class="text-muted mb-4">Something unexpected happened. Please try again, or return to the shop.</p>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <button type="button" class="btn btn-primary" onclick="window.location.reload();">
                        <i class="bi bi-arrow-clockwise me-1"></i>Try Again
                    </button>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                        <i class="bi bi-house me-1"></i>Back to Shop
                    </a>
                </div>
                @if (!string.IsNullOrWhiteSpace(requestId))
                {
                    <div class="small text-muted mt-4">Reference: @requestId</div>
                }
            </div>
        </div>
    </div>
</div>
