    <button id="backToTopBtn" title="Back to top">
        <i class="bi bi-arrow-up"></i>
    </button>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    <script>
        $(function () {
            var $toTop = $('#backToTopBtn');

            $(window).on('scroll', function () {
                var current = $(window).scrollTop();
                if (current > 300) {
                    $toTop.fadeIn(150);
                } else {
                    $toTop.fadeOut(150);
                }
            });

            $toTop.on('click', function () {
                $('html, body').animate({ scrollTop: 0 }, 300);
            });

            // =========================================================
            // Header search (compact) - same /Search/Global endpoint
            // used by the shop's search box.
            // =========================================================
            var $input = $('#hdrSearchInput');
            var $results = $('#hdrSearchResults');
            var $spinner = $('#hdrSearchSpinner');
            var debounceTimer = null;
            var currentRequest = null;

            function escapeHtml(str) {
                var div = document.createElement("div");
                div.innerText = str == null ? "" : str;
                return div.innerHTML;
            }

            function sectionIcon(key) {
                if (key === "Products") return "bi-box-seam";
                if (key === "Orders") return "bi-bag-check";
                if (key === "Users") return "bi-people";
                return "bi-dot";
            }

            function renderSection(key, items) {
                if (!items || items.length === 0) return "";
                var html = '<div class="hs-section-title"><i class="bi ' + sectionIcon(key) + ' me-1"></i>' + escapeHtml(key) + '</div>';
                items.forEach(function (item) {
                    html += '<a class="hs-item ajax-nav-link" href="' + item.url + '">' +
                        '<div class="hs-title">' + escapeHtml(item.title) + '</div>' +
                        '<div class="hs-subtitle">' + escapeHtml(item.subtitle) + '</div>' +
                        '</a>';
                });
                return html;
            }

            function showResults(data) {
                var html = "";
                html += renderSection("Products", data.products);
                html += renderSection("Orders", data.orders);
                html += renderSection("Users", data.users);

                if (!html) {
                    html = '<div class="hs-empty">No results found.</div>';
                }

                $results.html(html);
                $results.show();
            }

            if ($input.length) {
                $input.on('input', function () {
                    var term = $input.val().trim();
                    clearTimeout(debounceTimer);

                    if (term.length < 2) {
                        $results.hide();
                        return;
                    }

                    debounceTimer = setTimeout(function () {
                        if (currentRequest) { currentRequest.abort(); }
                        $spinner.show();

                        currentRequest = $.get('@Url.Action("Global", "Search")', { q: term })
                            .done(function (data) {
                                showResults(data);
                            })
                            .always(function () {
                                $spinner.hide();
                            });
                    }, 300);
                });

                $(document).on('click', function (e) {
                    if (!$(e.target).closest('.hdr-search-wrap').length) {
                        $results.hide();
                    }
                });
            }

            // =========================================================
            // Sidebar: pin open on click (tap) for touch devices,
            // hover already expands it on desktop via CSS.
            // =========================================================
            $('#sideNav').on('click', function (e) {
                if ($(window).width() < 768 && e.target === this) {
                    $(this).toggleClass('pinned-open');
                }
            });

            // =========================================================
            // AJAX content loading (pjax-style): clicking a sidebar or
            // top-nav link fetches the target page and swaps only the
            // #mainContent portion into the current page, so the
            // header/sidebar never reload. Falls back to a normal
            // full page navigation if anything goes wrong.
            // =========================================================
            function loadPage(url, pushState) {
                var $content = $('#mainContent');
                $content.addClass('ajax-loading');

                $.get(url)
                    .done(function (html) {
                        var parsedDoc = new DOMParser().parseFromString(html, 'text/html');
                        var newContentEl = parsedDoc.getElementById('mainContent');

                        if (!newContentEl) {
                            // Target page doesn't use this layout (e.g. a
                            // standalone page) - do a full navigation instead.
                            window.location.href = url;
                            return;
                        }

                        $content.html(newContentEl.innerHTML);
                        $content.removeClass('ajax-loading');

                        if (parsedDoc.title) {
                            document.title = parsedDoc.title;
                        }

                        // The layout renders each page's own @@section
                        // Scripts block AFTER #contentWrap (near the end
                        // of <body>), so it lives outside #mainContent.
                        // Re-run every <script> on the fetched page that
                        // isn't one of the shared CDN/layout scripts, so
                        // page-specific behaviour (image previews,
                        // dynamic rows, infinite scroll, etc.) still
                        // works after an AJAX navigation.
                        var sharedScriptSrc = ['bootstrap', 'jquery', 'modernizr', 'cdn.jsdelivr.net'];

                        parsedDoc.querySelectorAll('script').forEach(function (oldScript) {
                            var src = oldScript.getAttribute('src') || '';
                            var isShared = sharedScriptSrc.some(function (marker) {
                                return src.indexOf(marker) !== -1;
                            });

                            if (isShared) {
                                return;
                            }

                            var newScript = document.createElement('script');
                            if (src) {
                                newScript.src = src;
                            } else {
                                newScript.textContent = oldScript.textContent;
                            }
                            document.body.appendChild(newScript);
                            if (src) {
                                // Inline scripts run immediately on append;
                                // external ones are one-shot too - remove
                                // once loaded so repeat navigations don't
                                // pile up duplicate <script> tags.
                                newScript.onload = function () { newScript.remove(); };
                            } else {
                                newScript.remove();
                            }
                        });

                        if (pushState) {
                            window.history.pushState({ ajaxUrl: url }, '', url);
                        }

                        $('.side-link, .ajax-nav-link').removeClass('active');
                        $('.side-link[href="' + url + '"]').addClass('active');

                        window.scrollTo(0, 0);
                    })
                    .fail(function () {
                        window.location.href = url;
                    });
            }

            $(document).on('click', '.ajax-nav-link, .side-link', function (e) {
                var href = $(this).attr('href');

                if (!href || href.charAt(0) === '#' || $(this).attr('target') === '_blank') {
                    return;
                }

                e.preventDefault();
                loadPage(href, true);
            });

            window.addEventListener('popstate', function (e) {
                if (e.state && e.state.ajaxUrl) {
                    loadPage(e.state.ajaxUrl, false);
                } else {
                    window.location.reload();
                }
            });

            // Mark the current sidebar link active on first load.
            var currentPath = window.location.pathname.toLowerCase();
            $('.side-link').each(function () {
                var linkPath = $(this).attr('href');
                if (linkPath && linkPath.toLowerCase() === currentPath) {
                    $(this).addClass('active');
                }
            });
        });



       
    document.addEventListener("DOMContentLoaded", function () {

        const themeToggle = document.getElementById("themeToggle");
        const themeIcon = document.getElementById("themeIcon");

        if (!themeToggle || !themeIcon) return;


        /* ==========================================
           LOAD SAVED THEME
           ========================================== */

        const savedTheme = localStorage.getItem("bc-theme");

        if (savedTheme === "dark") {
            document.body.classList.add("dark-mode");

            themeIcon.classList.remove("bi-moon-stars-fill");
            themeIcon.classList.add("bi-sun-fill");
        }


        /* ==========================================
           TOGGLE THEME
           ========================================== */

        themeToggle.addEventListener("click", function () {

            document.body.classList.toggle("dark-mode");

            const isDark =
                document.body.classList.contains("dark-mode");


            if (isDark) {

                themeIcon.classList.remove(
                    "bi-moon-stars-fill"
                );

                themeIcon.classList.add(
                    "bi-sun-fill"
                );

                localStorage.setItem(
                    "bc-theme",
                    "dark"
                );

            } else {

                themeIcon.classList.remove(
                    "bi-sun-fill"
                );

                themeIcon.classList.add(
                    "bi-moon-stars-fill"
                );

                localStorage.setItem(
                    "bc-theme",
                    "light"
                );
            }

        });

    });



    function updateMessageUnreadCount() {

        $.ajax({

            url: '@Url.Action("UnreadCount", "Message")',

            type: 'GET',

            cache: false,

            success: function (response) {

                if (!response || !response.success) {
                    return;
                }

                const badge = $("#messageUnreadBadge");

                const count = parseInt(response.count) || 0;

                if (count > 0) {

                    badge.text(
                        count > 99 ? "99+" : count
                    );

                    badge.show();

                }
                else {

                    badge.hide();

                }

            },

            error: function () {

                console.log(
                    "Unable to load unread message count."
                );

            }

        });

    }


    // First load
    $(document).ready(function () {

        updateMessageUnreadCount();

    });


    // Refresh every 5 seconds
    setInterval(function () {

        updateMessageUnreadCount();

    }, 5000);

    

    </script>

</body>
