@model CustomAuthentication.ViewModel.UserManagementViewModel
@{ ViewBag.Title = "Add User"; }
<style>
.glass-card{background:rgba(255,255,255,.55);backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.6);border-radius:20px;box-shadow:0 8px 32px rgba(124,58,237,.15);}
.title-grad{background:linear-gradient(90deg,#3B82F6,#7C3AED);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.frm-control,.frm-control:focus{background:rgba(255,255,255,.7);border:1px solid rgba(124,58,237,.25);box-shadow:none;}
.lbl{color:#24324A;font-weight:600;}
.btn-glass{border:none;border-radius:10px;padding:10px 22px;background:linear-gradient(90deg,#3B82F6,#7C3AED);color:#fff;font-weight:600;}
.btn-ghost{border:none;border-radius:10px;padding:10px 22px;background:linear-gradient(145deg,#ffffff,#EDE9FE);color:#7C3AED;font-weight:600;}
.btn-ghost:hover{color:#7C3AED;text-decoration:none;}
</style>
<div class="container py-5">
    @Html.Partial("_BackBar", new List<CustomAuthentication.ViewModel.BackBarLink>
    {
        new CustomAuthentication.ViewModel.BackBarLink("Dashboard", "Admin", "Dashboard"),
        new CustomAuthentication.ViewModel.BackBarLink("Users", "User", "Index")
    })
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="glass-card p-4 p-md-5">
                <h3 class="fw-bold title-grad mb-4"><i class="bi bi-person-plus-fill me-2"></i>Add User</h3>
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.FullName, new { @class = "form-label lbl" })
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control frm-control" })
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Phone, new { @class = "form-label lbl" })
                            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control frm-control" })
                            @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label lbl" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control frm-control", type = "email" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>
                    <div class="alert alert-info mb-3" style="border-radius:14px;">
                        <i class="bi bi-envelope-check me-2"></i>
                        The user will receive an email with a secure link to create their own password.
                        The link is valid for <strong> @CustomAuthentication.Helpers.InvitationHelper.ExpiryHours hours</strong>.
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            @Html.Label("RoleName", "Role", new { @class = "form-label lbl" })
                            @Html.DropDownListFor(m => m.RoleName, Model.RoleOptions, "-- Select Role --", new { @class = "form-select frm-control", id = "roleSelect" })
                        </div>
                        <div class="col-md-6" id="warehouseField">
                            @Html.Label("WarehouseId", "Warehouse", new { @class = "form-label lbl" })
                            @Html.DropDownListFor(m => m.WarehouseId, Model.WarehouseOptions, "-- Select Warehouse --", new { @class = "form-select frm-control" })
                        </div>
                    </div>
                    <div class="form-check form-switch mb-4">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                        @Html.LabelFor(m => m.IsActive, "Active", new { @class = "form-check-label" })
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <a href="@Url.Action("Index")" class="btn-ghost">Cancel</a>
                        <button type="submit" class="btn-glass"><i class="bi bi-envelope-paper me-1"></i>Create & Send Invite</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
