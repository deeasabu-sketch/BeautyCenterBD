@model CustomAuthentication.ViewModel.UserManagementViewModel
@{ ViewBag.Title = "Edit User"; }
<style>
    .glass-card {
        background: rgba(255,255,255,.55);
        backdrop-filter: blur(14px);
        border: 1px solid rgba(255,255,255,.6);
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(124,58,237,.15);
    }

    .title-grad {
        background: linear-gradient(90deg,#3B82F6,#7C3AED);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .frm-control, .frm-control:focus {
        background: rgba(255,255,255,.7);
        border: 1px solid rgba(124,58,237,.25);
        box-shadow: none;
    }

    .lbl {
        color: #24324A;
        font-weight: 600;
    }

    .btn-glass {
        border: none;
        border-radius: 10px;
        padding: 10px 22px;
        background: linear-gradient(90deg,#3B82F6,#7C3AED);
        color: #fff;
        font-weight: 600;
    }

    .btn-ghost {
        border: none;
        border-radius: 10px;
        padding: 10px 22px;
        background: linear-gradient(145deg,#ffffff,#EDE9FE);
        color: #7C3AED;
        font-weight: 600;
    }

        .btn-ghost:hover {
            color: #7C3AED;
            text-decoration: none;
        }
</style>
<div class="container py-5">
    @Html.Partial("_BackBar", new List<CustomAuthentication.ViewModel.BackBarLink>
    {
        new CustomAuthentication.ViewModel.BackBarLink("Dashboard", "Admin", "Dashboard"),
        new CustomAuthentication.ViewModel.BackBarLink("Users", "User", "Index")
    })
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="glass-card p-4 p-md-5">
                <h3 class="fw-bold title-grad mb-4"><i class="bi bi-person-gear me-2"></i>Edit User</h3>
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.UserId)
                    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.FullName, new { @class = "form-label lbl" })
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control frm-control" })
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Phone, new { @class = "form-label lbl" })
                            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control frm-control" })
                            @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label lbl" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control frm-control", type = "email" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label lbl" })
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control frm-control", placeholder = "Leave blank to keep current password" })
                        <small class="text-muted">Leave blank if you don't want to change the password.</small>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            @Html.Label("RoleName", "Role", new { @class = "form-label lbl" })
                            @Html.DropDownListFor(m => m.RoleName, Model.RoleOptions, "-- Select Role --", new { @class = "form-select frm-control", id = "roleSelect" })
                            @Html.ValidationMessageFor(m => m.RoleName, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6" id="warehouseField">
                            @Html.Label("WarehouseId", "Warehouse", new { @class = "form-label lbl" })
                            @Html.DropDownListFor(m => m.WarehouseId, Model.WarehouseOptions, "-- Select Warehouse --", new { @class = "form-select frm-control" })
                            @Html.ValidationMessageFor(m => m.WarehouseId, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="form-check form-switch mb-4">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                        @Html.LabelFor(m => m.IsActive, "Active", new { @class = "form-check-label" })
                    </div>

                    <!-- ========================= -->
                    <!-- PER-USER PERMISSIONS BOX  -->
                    <!-- ========================= -->
                    <div class="card border shadow-sm mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0"><i class="bi bi-shield-check me-2"></i>User Permissions</h5>
                            <small class="text-muted">These override the role's default access for THIS user only.</small>
                        </div>
                        <div class="card-body">
                            <div class="row g-4">

                                <div class="col-md-4">
                                    <h6 class="fw-bold border-bottom pb-2">Dashboard</h6>
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.CanViewDashboard, new { @class = "form-check-input" })
                                        <label class="form-check-label">View Dashboard</label>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <h6 class="fw-bold border-bottom pb-2">Products</h6>
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.CanViewProducts, new { @class = "form-check-input" })
                                        <label class="form-check-label">View Products</label>
                                    </div>
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.CanAddProducts, new { @class = "form-check-input" })
                                        <label class="form-check-label">Add Products</label>
                                    </div>
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.CanEditProducts, new { @class = "form-check-input" })
                                        <label class="form-check-label">Edit Products</label>
                                    </div>
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.CanDeleteProducts, new { @class = "form-check-input" })
                                        <label class="form-check-label">Delete Products</label>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <h6 class="fw-bold border-bottom pb-2">Orders</h6>
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.CanViewOrders, new { @class = "form-check-input" })
                                        <label class="form-check-label">View Orders</label>
                                    </div>
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.CanAddOrders, new { @class = "form-check-input" })
                                        <label class="form-check-label">Add Orders</label>
                                    </div>
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.CanEditOrders, new { @class = "form-check-input" })
                                        <label class="form-check-label">Edit Orders</label>
                                    </div>
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.CanDeleteOrders, new { @class = "form-check-input" })
                                        <label class="form-check-label">Delete Orders</label>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <h6 class="fw-bold border-bottom pb-2">Reports</h6>
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.CanViewReports, new { @class = "form-check-input" })
                                        <label class="form-check-label">View Reports</label>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <h6 class="fw-bold border-bottom pb-2">User Management</h6>
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.CanManageUsers, new { @class = "form-check-input" })
                                        <label class="form-check-label">Manage Users</label>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <h6 class="fw-bold border-bottom pb-2">Notebook</h6>
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.CanViewNotebook, new { @class = "form-check-input" })
                                        <label class="form-check-label">View Notebook</label>
                                    </div>
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.CanAddNotebook, new { @class = "form-check-input" })
                                        <label class="form-check-label">Add Notebook</label>
                                    </div>
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.CanEditNotebook, new { @class = "form-check-input" })
                                        <label class="form-check-label">Edit Notebook</label>
                                    </div>
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.CanDeleteNotebook, new { @class = "form-check-input" })
                                        <label class="form-check-label">Delete Notebook</label>
                                    </div>

                                </div>
                                <div class="col-md-4">
                                    <h6 class="fw-bold border-bottom pb-2">Promo Codes</h6>
                                    <div class="form-check">
                                        @Html.CheckBoxFor(m => m.CanManagePromoCodes, new { @class = "form-check-input" })
                                        <label class="form-check-label">Manage Promo Codes</label>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="@Url.Action("Index")" class="btn-ghost">Cancel</a>
                        <button type="submit" class="btn-glass"><i class="bi bi-check-circle me-1"></i>Update</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>