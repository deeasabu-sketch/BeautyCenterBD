@model IEnumerable<CustomAuthentication.Models.User>
@{ ViewBag.Title = "Users"; }
<style>
.glass-card{background:rgba(255,255,255,.55);backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.6);border-radius:20px;box-shadow:0 8px 32px rgba(124,58,237,.15);}
.title-grad{background:linear-gradient(90deg,#3B82F6,#7C3AED);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.btn-glass{border:none;border-radius:10px;padding:8px 18px;background:linear-gradient(90deg,#3B82F6,#7C3AED);color:#fff;font-weight:600;}
.btn-ghost{border:none;border-radius:10px;padding:8px 18px;background:linear-gradient(145deg,#ffffff,#EDE9FE);color:#7C3AED;font-weight:600;}
.btn-ghost:hover{color:#7C3AED;text-decoration:none;}
.btn-ghost-sm{border:none;border-radius:8px;padding:5px 12px;background:linear-gradient(145deg,#ffffff,#EDE9FE);color:#7C3AED;font-weight:600;font-size:.85rem;}
.btn-warn-sm{border:none;border-radius:8px;padding:5px 12px;background:linear-gradient(90deg,#ffb46f,#ff8f6f);color:#fff;font-weight:600;font-size:.85rem;}
.user-avatar{width:38px;height:38px;border-radius:50%;background:linear-gradient(145deg,#ffffff,#EDE9FE);color:#7C3AED;display:flex;align-items:center;justify-content:center;font-weight:700;}
</style>
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h2 class="fw-bold mb-1 title-grad"><i class="bi bi-people-fill me-2"></i>Users</h2><p class="mb-0" style="color:#64748B;">Manage staff accounts and roles</p></div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Dashboard","Admin")" class="btn-ghost"><i class="bi bi-arrow-left me-1"></i>Dashboard</a>
            <a href="@Url.Action("Index","Permission")" class="btn-ghost"><i class="bi bi-shield-lock me-1"></i>Permissions</a>
            <a href="@Url.Action("Create")" class="btn-glass"><i class="bi bi-person-plus-fill me-1"></i>Add User</a>
            <button type="button" class="graph-btn" data-graph="users" data-title="Users by designation">
                <i class="bi bi-bar-chart-fill"></i> Graph
            </button>
        </div>
    </div>
    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
    <div class="glass-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th class="ps-4">User</th><th>Role</th><th>Warehouse</th><th>Phone</th><th>Status</th><th>Invitation</th><th class="text-end pe-4">Actions</th></tr></thead>
                <tbody>
                @if (!Model.Any()) { <tr><td colspan="7" class="text-center py-4" style="color:#64748B;">No users yet.</td></tr> }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-2">
                                <div class="user-avatar">@item.FullName.Substring(0,1).ToUpper()</div>
                                <div>
                                    <div class="fw-semibold" style="color:#24324A;">@item.FullName</div>
                                    <div style="color:#64748B;font-size:.8rem;">@item.Email</div>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge" style="background:linear-gradient(90deg,#3B82F6,#7C3AED);color:#fff;">@item.RoleName</span></td>
                        <td style="color:#64748B;">@(item.Warehouse?.Name ?? "-")</td>
                        <td style="color:#64748B;">@item.Phone</td>
                        <td>
                            @if (item.IsActive) { <span class="badge bg-success">Active</span> }
                            else { <span class="badge bg-secondary">Inactive</span> }
                        </td>
                        <td>
                            @if (item.PasswordSetupCompletedAt.HasValue)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Set</span>
                            }
                            else if (item.PasswordSetupExpiresAt.HasValue && item.PasswordSetupExpiresAt.Value < DateTime.Now)
                            {
                                <span class="badge bg-danger"><i class="bi bi-clock-history me-1"></i>Expired</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark"><i class="bi bi-envelope me-1"></i>Pending</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <a href="@Url.Action("Edit", new { id = item.UserId })" class="btn-ghost-sm"><i class="bi bi-pencil"></i> Edit</a>
                            @if (!item.PasswordSetupCompletedAt.HasValue)
                            {
                                using (Html.BeginForm("ResendInvitation", "User", new { id = item.UserId }, FormMethod.Post, new { style = "display:inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-ghost-sm" onclick="return confirm('Send a fresh password setup email to @item.Email?');"><i class="bi bi-send"></i> Resend Invite</button>
                                }
                            }
                            @using (Html.BeginForm("ToggleActive", "User", new { id = item.UserId }, FormMethod.Post, new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-warn-sm" onclick="return confirm('@(item.IsActive ? "Deactivate" : "Activate") this user?');">
                                    @(item.IsActive ? "Deactivate" : "Activate")
                                </button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@Html.Partial("_GraphModal")
