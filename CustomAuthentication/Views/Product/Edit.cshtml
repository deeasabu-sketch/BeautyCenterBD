@model CustomAuthentication.ViewModel.ProductViewModel

@{
    ViewBag.Title = "Edit Product";
}

<style>
    .pe-glass { background: rgba(255,255,255,0.55); backdrop-filter: blur(14px); border: 1px solid rgba(255,255,255,0.6); border-radius: 20px; box-shadow: 0 8px 32px rgba(124,58,237,0.15); }
    .pe-title-grad { background: linear-gradient(90deg,#3B82F6,#7C3AED); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .pe-form-control, .pe-form-control:focus { background: rgba(255,255,255,0.7); border: 1px solid rgba(124,58,237,0.25); box-shadow: none; }
    .pe-label { color: #24324A; font-weight: 600; }
    .pe-btn { border: none; border-radius: 10px; padding: 10px 22px; background: linear-gradient(90deg,#3B82F6,#7C3AED); color:#fff; font-weight:600; }
    .pe-btn-ghost { border: none; border-radius: 10px; padding: 10px 22px; background: linear-gradient(145deg,#ffffff,#EDE9FE); color:#7C3AED; font-weight:600; }
    .pe-btn-ghost:hover { color:#7C3AED; text-decoration:none; }
    .pe-current-img, .gallery-thumb { max-width: 140px; max-height: 140px; object-fit: cover; border-radius: 12px; }
</style>

<div class="container-fluid py-2">
    @Html.Partial("_BackBar", new List<CustomAuthentication.ViewModel.BackBarLink>
    {
        new CustomAuthentication.ViewModel.BackBarLink("Dashboard", "Admin", "Dashboard"),
        new CustomAuthentication.ViewModel.BackBarLink("Products", "Product", "Index")
    })
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="pe-glass p-4">
                <h3 class="fw-bold pe-title-grad mb-1"><i class="bi bi-pencil-square me-2"></i>Edit Product</h3>

                @using (Html.BeginForm("Edit", "Product", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ProductId)
                    @Html.HiddenFor(m => m.ExistingImagePath)
                    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.ProductName, new { @class = "form-label pe-label" })
                    @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control pe-form-control" })
                    @Html.ValidationMessageFor(m => m.ProductName, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.SKU, new { @class = "form-label pe-label" })
                    @Html.TextBoxFor(m => m.SKU, new { @class = "form-control pe-form-control" })
                </div>

                <div class="col-md-4 mb-3">
                    @Html.Label("CategoryId", "Category", new { @class = "form-label pe-label" })
                    @Html.DropDownListFor(m => m.CategoryId, Model.CategoryOptions, new { @class = "form-select pe-form-control" })
                </div>
                <div class="col-md-4 mb-3">
                    @Html.Label("BrandId", "Brand", new { @class = "form-label pe-label" })
                    @Html.DropDownListFor(m => m.BrandId, Model.BrandOptions, new { @class = "form-select pe-form-control" })
                </div>
                <div class="col-md-4 mb-3">
                    @Html.Label("UnitId", "Unit", new { @class = "form-label pe-label" })
                    @Html.DropDownListFor(m => m.UnitId, Model.UnitOptions, new { @class = "form-select pe-form-control" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.StockQuantity, new { @class = "form-label pc-label" })
                    @Html.TextBoxFor(m => m.StockQuantity, new { @class = "form-control pc-form-control" })
                    @Html.ValidationMessageFor(m => m.StockQuantity, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-4 mb-3">
                    @Html.LabelFor(m => m.PurchasePrice, new { @class = "form-label pe-label" })
                    @Html.TextBoxFor(m => m.PurchasePrice, new { @class = "form-control pe-form-control", type = "number", step = "0.01" })
                </div>
                <div class="col-md-4 mb-3">
                    @Html.LabelFor(m => m.UnitPrice, new { @class = "form-label pe-label" })
                    @Html.TextBoxFor(m => m.UnitPrice, new { @class = "form-control pe-form-control", type = "number", step = "0.01" })
                </div>
                <div class="col-md-4 mb-3">
                    @Html.LabelFor(m => m.DiscountPercent, "Discount %", new { @class = "form-label pe-label" })
                    @Html.TextBoxFor(m => m.DiscountPercent, new { @class = "form-control pe-form-control", type = "number", step = "0.01" })
                </div>

                <div class="col-md-4 mb-3">
                    @Html.LabelFor(m => m.ReorderLevel, new { @class = "form-label pe-label" })
                    @Html.TextBoxFor(m => m.ReorderLevel, new { @class = "form-control pe-form-control", type = "number" })
                </div>

                <div class="col-12 mb-3">
                    @Html.LabelFor(m => m.Description, new { @class = "form-label pe-label" })
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control pe-form-control", rows = "3" })
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label pe-label">Current Cover Image</label>
                    @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
                    {
                        <div><img src="@Url.Content(Model.ExistingImagePath)" class="pe-current-img" /></div>
                    }
                    <input type="file" name="CoverImage" class="form-control pe-form-control mt-2" accept=".jpg,.jpeg,.png,.gif,.webp" />
                    <small style="color:#64748B;">Leave empty to keep current image.</small>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label pe-label">Add Gallery Images</label>
                    <input type="file" name="GalleryImages" multiple class="form-control pe-form-control mt-2" accept=".jpg,.jpeg,.png,.gif,.webp" />

                    @if (Model.ExistingGalleryImages != null && Model.ExistingGalleryImages.Any())
                    {
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            @foreach (var g in Model.ExistingGalleryImages)
                            {
                                <div>
                                    <img src="@Url.Content(g.ImagePath)" class="gallery-thumb" />
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="col-12 mb-3 form-check form-switch">
                    @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                    @Html.LabelFor(m => m.IsActive, "Active", new { @class = "form-check-label" })
                </div>
            </div>

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <a href="@Url.Action("Index")" class="pe-btn-ghost">Cancel</a>
                        <button type="submit" class="pe-btn"><i class="bi bi-save me-1"></i> Update Product</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
