@model CustomAuthentication.ViewModel.ProductViewModel

@{
    ViewBag.Title = "Add Product";
}

<style>
    .pc-glass { background: rgba(255,255,255,0.55); backdrop-filter: blur(14px); border: 1px solid rgba(255,255,255,0.6); border-radius: 20px; box-shadow: 0 8px 32px rgba(124,58,237,0.15); }
    .pc-title-grad { background: linear-gradient(90deg,#3B82F6,#7C3AED); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .pc-form-control, .pc-form-control:focus { background: rgba(255,255,255,0.7); border: 1px solid rgba(124,58,237,0.25); box-shadow: none; }
    .pc-label { color: #24324A; font-weight: 600; }
    .pc-btn { border: none; border-radius: 10px; padding: 10px 22px; background: linear-gradient(90deg,#3B82F6,#7C3AED); color:#fff; font-weight:600; }
    .pc-btn:hover { color:#fff; opacity:.92; }
    .pc-btn-ghost { border: none; border-radius: 10px; padding: 10px 22px; background: linear-gradient(145deg,#ffffff,#EDE9FE); color:#7C3AED; font-weight:600; }
    .pc-btn-ghost:hover { color:#7C3AED; text-decoration:none; }
    .pc-upload-box { border: 2px dashed rgba(124,58,237,0.35); border-radius: 16px; padding: 18px; background: rgba(255,255,255,0.4); text-align: center; }
    .pc-preview { max-width: 220px; max-height: 220px; object-fit: cover; border-radius: 14px; margin-top: 12px; }
</style>

<div class="container-fluid py-2">
    @Html.Partial("_BackBar", new List<CustomAuthentication.ViewModel.BackBarLink>
    {
        new CustomAuthentication.ViewModel.BackBarLink("Dashboard", "Admin", "Dashboard"),
        new CustomAuthentication.ViewModel.BackBarLink("Products", "Product", "Index")
    })
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="pc-glass p-4">
                <h3 class="fw-bold pc-title-grad mb-1"><i class="bi bi-bag-plus me-2"></i>Add Product</h3>

                @using (Html.BeginForm("Create", "Product", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.ProductName, new { @class = "form-label pc-label" })
                    @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control pc-form-control" })
                    @Html.ValidationMessageFor(m => m.ProductName, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.SKU, new { @class = "form-label pc-label" })
                    @Html.TextBoxFor(m => m.SKU, new { @class = "form-control pc-form-control" })
                </div>

                <div class="col-md-4 mb-3">
                    @Html.Label("CategoryId", "Category", new { @class = "form-label pc-label" })
                    @Html.DropDownListFor(m => m.CategoryId, Model.CategoryOptions, "-- Select --", new { @class = "form-select pc-form-control" })
                    @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-4 mb-3">
                    @Html.Label("BrandId", "Brand", new { @class = "form-label pc-label" })
                    @Html.DropDownListFor(m => m.BrandId, Model.BrandOptions, "-- Select --", new { @class = "form-select pc-form-control" })
                    @Html.ValidationMessageFor(m => m.BrandId, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-4 mb-3">
                    @Html.Label("UnitId", "Unit", new { @class = "form-label pc-label" })
                    @Html.DropDownListFor(m => m.UnitId, Model.UnitOptions, "-- Select --", new { @class = "form-select pc-form-control" })
                    @Html.ValidationMessageFor(m => m.UnitId, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.StockQuantity, new { @class = "form-label pc-label" })
                    @Html.TextBoxFor(m => m.StockQuantity, new { @class = "form-control pc-form-control" })
                    @Html.ValidationMessageFor(m => m.StockQuantity, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-4 mb-3">
                    @Html.LabelFor(m => m.PurchasePrice, new { @class = "form-label pc-label" })
                    @Html.TextBoxFor(m => m.PurchasePrice, new { @class = "form-control pc-form-control", type = "number", step = "0.01" })
                </div>
                <div class="col-md-4 mb-3">
                    @Html.LabelFor(m => m.UnitPrice, new { @class = "form-label pc-label" })
                    @Html.TextBoxFor(m => m.UnitPrice, new { @class = "form-control pc-form-control", type = "number", step = "0.01" })
                    @Html.ValidationMessageFor(m => m.UnitPrice, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-4 mb-3">
                    @Html.LabelFor(m => m.DiscountPercent, "Discount %", new { @class = "form-label pc-label" })
                    @Html.TextBoxFor(m => m.DiscountPercent, new { @class = "form-control pc-form-control", type = "number", step = "0.01", min = "0", max = "100" })
                </div>

                <div class="col-md-4 mb-3">
                    @Html.LabelFor(m => m.ReorderLevel, new { @class = "form-label pc-label" })
                    @Html.TextBoxFor(m => m.ReorderLevel, new { @class = "form-control pc-form-control", type = "number", min = "0" })
                </div>

                <div class="col-12 mb-3">
                    @Html.LabelFor(m => m.Description, new { @class = "form-label pc-label" })
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control pc-form-control", rows = "3" })
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label pc-label">Cover Image</label>
                    <div class="pc-upload-box">
                        <input type="file" name="CoverImage" class="form-control pc-form-control mt-2" accept=".jpg,.jpeg,.png,.gif,.webp" />
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label pc-label">Gallery Images (optional, multiple)</label>
                    <div class="pc-upload-box">
                        <input type="file" name="GalleryImages" multiple class="form-control pc-form-control mt-2" accept=".jpg,.jpeg,.png,.gif,.webp" />
                    </div>
                </div>

                <div class="col-12 mb-3 form-check form-switch">
                    @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                    @Html.LabelFor(m => m.IsActive, "Active", new { @class = "form-check-label" })
                </div>
            </div>

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <a href="@Url.Action("Index")" class="pc-btn-ghost">Cancel</a>
                        <button type="submit" class="pc-btn"><i class="bi bi-check-circle me-1"></i> Add Product</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
