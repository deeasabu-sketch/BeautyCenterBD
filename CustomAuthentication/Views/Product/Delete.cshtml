@model CustomAuthentication.Models.Product

@{
    ViewBag.Title = "Delete Product";
}

<style>
    .pdel-glass {
        background: rgba(255,255,255,0.55);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255,255,255,0.6);
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(124,58,237,0.15);
    }
    .pdel-title-grad {
        background: linear-gradient(90deg,#3B82F6,#7C3AED);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .pdel-warning {
        background: rgba(255,111,111,0.12);
        border: 1px solid rgba(255,111,111,0.3);
        border-radius: 14px;
        padding: 14px 18px;
        color: #b23b3b;
    }
    .pdel-img {
        width: 100%;
        max-height: 220px;
        object-fit: cover;
        border-radius: 16px;
        box-shadow: 0 6px 18px rgba(124,58,237,0.2);
    }
    .pdel-img-placeholder {
        width: 100%;
        height: 200px;
        border-radius: 16px;
        display: flex; align-items: center; justify-content: center;
        background: linear-gradient(145deg,#ffffff,#EDE9FE);
        color: #7C3AED;
        font-size: 2.4rem;
    }
    .pdel-label { color:#64748B; font-size:.8rem; }
    .pdel-value { color:#24324A; font-weight:600; }
    .pdel-btn-ghost {
        border: none; border-radius: 10px; padding: 10px 18px;
        background: linear-gradient(145deg,#ffffff,#EDE9FE); color:#7C3AED; font-weight:600;
        box-shadow: 4px 4px 10px rgba(124,58,237,0.15), -4px -4px 10px rgba(255,255,255,0.9);
    }
    .pdel-btn-ghost:hover { color:#7C3AED; text-decoration:none; }
    .pdel-btn-danger {
        border: none; border-radius: 10px; padding: 10px 18px;
        background: linear-gradient(90deg,#EF4444,#FB923C); color:#fff; font-weight:600;
        box-shadow: 4px 4px 10px rgba(255,111,111,0.25);
    }
    .pdel-btn-danger:hover { color:#fff; opacity:.92; }
</style>

<div class="container-fluid py-2">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="pdel-glass p-4">

                <h3 class="fw-bold pdel-title-grad mb-3">
                    <i class="bi bi-trash3 me-2"></i>Delete Product
                </h3>

                <div class="pdel-warning mb-4">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Warning!</strong> Are you sure you want to delete this product? This action cannot be undone.
                </div>

                <div class="row g-4">

                    <!-- Product Image -->
                    <div class="col-md-4">
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <img src="@Url.Content(Model.ImagePath)" alt="@Model.ProductName" class="pdel-img" />
                        }
                        else
                        {
                            <div class="pdel-img-placeholder"><i class="bi bi-image"></i></div>
                        }
                    </div>

                    <!-- Product Information -->
                    <div class="col-md-8">

                        <div class="mb-2">
                            <span class="pdel-label d-block">Product Name</span>
                            <span class="pdel-value">@Model.ProductName</span>
                        </div>

                        <div class="mb-2">
                            <span class="pdel-label d-block">Category</span>
                            <span class="pdel-value">@(Model.Category == null ? "-" : Model.Category.Name)</span>
                        </div>

                        <div class="mb-2">
                            <span class="pdel-label d-block">Description</span>
                            <span class="pdel-value">@(string.IsNullOrEmpty(Model.Description) ? "-" : Model.Description)</span>
                        </div>

                        <div class="row">
                            <div class="col-6 mb-2">
                                <span class="pdel-label d-block">Unit Price</span>
                                <span class="pdel-value">Taka @Model.UnitPrice.ToString("N2")</span>
                            </div>
                            <div class="col-6 mb-2">
                                <span class="pdel-label d-block">Stock Quantity</span>
                                <span class="pdel-value">@Model.StockQuantity</span>
                            </div>
                            <div class="col-6 mb-2">
                                <span class="pdel-label d-block">Status</span>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </div>
                            <div class="col-6 mb-2">
                                <span class="pdel-label d-block">Created Date</span>
                                <span class="pdel-value">@Model.CreateDate.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>

                    </div>

                </div>

                <hr style="border-color:rgba(124,58,237,0.2);" class="my-4" />

                @using (Html.BeginForm("Delete", "Product", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    @Html.HiddenFor(model => model.ProductId)

                    <div class="d-flex justify-content-between">

                        <a href="@Url.Action("Index", "Product")" class="pdel-btn-ghost">
                            <i class="bi bi-arrow-left me-1"></i> Cancel
                        </a>

                        <button type="submit" class="pdel-btn-danger"
                                onclick="return confirm('Are you sure you want to delete this product?');">
                            <i class="bi bi-trash3 me-1"></i> Delete Product
                        </button>

                    </div>
                }

            </div>

        </div>
    </div>
</div>
