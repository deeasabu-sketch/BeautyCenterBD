@model IEnumerable<CustomAuthentication.Models.Salary>
@{ ViewBag.Title = "Salaries"; }
<style>
.glass-card{background:rgba(255,255,255,.55);backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.6);border-radius:20px;box-shadow:0 8px 32px rgba(124,58,237,.15);}
.title-grad{background:linear-gradient(90deg,#3B82F6,#7C3AED);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.btn-glass{border:none;border-radius:10px;padding:8px 18px;background:linear-gradient(90deg,#3B82F6,#7C3AED);color:#fff;font-weight:600;}
.btn-ghost{border:none;border-radius:10px;padding:8px 18px;background:linear-gradient(145deg,#ffffff,#EDE9FE);color:#7C3AED;font-weight:600;}
.btn-ghost:hover{color:#7C3AED;text-decoration:none;}
.btn-ghost-sm{border:none;border-radius:8px;padding:5px 12px;background:linear-gradient(145deg,#ffffff,#EDE9FE);color:#7C3AED;font-weight:600;font-size:.85rem;}
</style>
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h2 class="fw-bold mb-1 title-grad"><i class="bi bi-cash-stack me-2"></i>Salaries</h2><p class="mb-0" style="color:#64748B;">Staff salary records</p></div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Dashboard","Admin")" class="btn-ghost"><i class="bi bi-arrow-left me-1"></i>Dashboard</a>
            <a href="@Url.Action("Create")" class="btn-glass"><i class="bi bi-plus-lg me-1"></i>Add Salary</a>
        </div>
    </div>
    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
    <div class="glass-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th class="ps-4">Employee</th><th>Month/Year</th><th>Net Salary</th><th>Status</th><th class="text-end pe-4">Actions</th></tr></thead>
                <tbody>
                @if (!Model.Any()) { <tr><td colspan="5" class="text-center py-4" style="color:#64748B;">No salary records yet.</td></tr> }
                @{ string[] months = { "", "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" }; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-semibold" style="color:#24324A;">@(item.User?.FullName ?? "-")</td>
                        <td style="color:#64748B;">@months[item.SalaryMonth] @item.SalaryYear</td>
                        <td style="color:#24324A;" class="fw-semibold">Taka @item.NetSalary.ToString("N2")</td>
                        <td>
                            @if (item.Status == "Paid") { <span class="badge bg-success">Paid</span> }
                            else { <span class="badge bg-warning text-dark">Pending</span> }
                        </td>
                        <td class="text-end pe-4"><a href="@Url.Action("Details", new { id = item.SalaryId })" class="btn-ghost-sm"><i class="bi bi-eye"></i> View</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
