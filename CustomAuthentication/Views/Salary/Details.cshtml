@model CustomAuthentication.Models.Salary
@{ ViewBag.Title = "Salary Details"; string[] months = { "", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" }; }
<style>
.glass-card{background:rgba(255,255,255,.55);backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.6);border-radius:20px;box-shadow:0 8px 32px rgba(124,58,237,.15);}
.title-grad{background:linear-gradient(90deg,#3B82F6,#7C3AED);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.btn-ghost{border:none;border-radius:10px;padding:8px 18px;background:linear-gradient(145deg,#ffffff,#EDE9FE);color:#7C3AED;font-weight:600;}
.btn-ghost:hover{color:#7C3AED;text-decoration:none;}
.btn-glass{border:none;border-radius:10px;padding:8px 18px;background:linear-gradient(90deg,#3B82F6,#7C3AED);color:#fff;font-weight:600;}
.lbl{color:#64748B;font-size:.8rem;} .val{color:#24324A;font-weight:600;}
</style>
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0 title-grad"><i class="bi bi-cash-stack me-2"></i>Salary - @months[Model.SalaryMonth] @Model.SalaryYear</h2>
        <a href="@Url.Action("Index")" class="btn-ghost"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
    @if (TempData["Success"] != null)
    {<div class="alert alert-success">@TempData["Success"]</div>}
    <div class="glass-card p-4 mb-4">
        <div class="row g-3">
            <div class="col-md-4"><span class="lbl d-block">Employee</span><span class="val">@(Model.User?.FullName ?? "-")</span></div>
            <div class="col-md-4"><span class="lbl d-block">Basic Salary</span><span class="val">Taka @Model.BasicSalary.ToString("N2")</span></div>
            <div class="col-md-4"><span class="lbl d-block">Bonus</span><span class="val">Taka @Model.Bonus.ToString("N2")</span></div>
            <div class="col-md-4"><span class="lbl d-block">Deduction</span><span class="val">Taka @Model.Deduction.ToString("N2")</span></div>
            <div class="col-md-4"><span class="lbl d-block">Net Salary</span><span class="val title-grad">Taka @Model.NetSalary.ToString("N2")</span></div>
            <div class="col-md-4">
                <span class="lbl d-block">Status</span>
                @if (Model.Status == "Paid")
                {<span class="badge bg-success">Paid</span> }
                else
                { <span class="badge bg-warning text-dark">Pending</span>}
            </div>
            @if (!string.IsNullOrEmpty(Model.Remarks))
            {
                <div class="col-12"><span class="lbl d-block">Remarks</span><span class="val">@Model.Remarks</span></div>
            }
        </div>
    </div>
   
        @if (Model.Status != "Paid")
        {
            using (Html.BeginForm("MarkPaid", "Salary", new { id = Model.SalaryId }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle me-1"></i>
                    Mark as Paid
                </button>
            }
        }
    
</div>
