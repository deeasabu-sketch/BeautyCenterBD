@model List<CustomAuthentication.Models.PromoCode>
@{ ViewBag.Title = "Promo Codes"; }
<style>
    .glass-card {
        background: rgba(255,255,255,.55);
        backdrop-filter: blur(14px);
        border: 1px solid rgba(255,255,255,.6);
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(124,58,237,.15);
    }

    .title-grad {
        background: linear-gradient(90deg,#3B82F6,#7C3AED);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .btn-glass {
        border: none;
        border-radius: 10px;
        padding: 8px 18px;
        background: linear-gradient(90deg,#3B82F6,#7C3AED);
        color: #fff;
        font-weight: 600;
    }

    .badge-active {
        background: #20c997;
        color: #fff;
    }

    .badge-inactive {
        background: #adb5bd;
        color: #fff;
    }
</style>
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold title-grad mb-0"><i class="bi bi-tags me-2"></i>Promo Codes</h3>
        <a href="@Url.Action("Create")" class="btn-glass"><i class="bi bi-plus-circle me-1"></i>New Promo Code</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="glass-card p-4">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Description</th>
                    <th>Discount</th>
                    <th>Min Order</th>
                    <th>Expiry</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-bold">@p.Code</td>
                        <td>@p.Description</td>
                        <td>@p.DiscountPercent.ToString("0.##")%</td>
                        <td>@(p.MinOrderAmount.HasValue ? "Taka " + p.MinOrderAmount.Value.ToString("N0") : "-")</td>
                        <td>@(p.ExpiryDate.HasValue ? p.ExpiryDate.Value.ToString("dd MMM, yyyy") : "No expiry")</td>
                        <td>
                            @if (p.IsActive)
                            {
                                <span class="badge badge-active">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-inactive">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="@Url.Action("Edit", new { id = p.PromoCodeId })" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                            @using (Html.BeginForm("Delete", "PromoCode", new { id = p.PromoCodeId }, FormMethod.Post, new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this promo code?');"><i class="bi bi-trash"></i></button>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No promo codes yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>