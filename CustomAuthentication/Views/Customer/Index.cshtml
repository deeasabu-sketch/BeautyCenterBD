@model IEnumerable<CustomAuthentication.Models.Customer>

@{
    ViewBag.Title = "Customers";
}

<style>
    .glass-card { background: rgba(255,255,255,0.55); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border: 1px solid rgba(255,255,255,0.6); border-radius: 20px; box-shadow: 0 8px 32px rgba(124,58,237,0.15); }
    .title-grad { background: linear-gradient(90deg,#3B82F6,#7C3AED); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .btn-glass { border: none; border-radius: 10px; padding: 8px 18px; background: linear-gradient(90deg,#3B82F6,#7C3AED); color:#fff; font-weight:600; box-shadow: 4px 4px 10px rgba(124,58,237,0.25); }
    .btn-glass:hover { color:#fff; opacity:.92; text-decoration:none; }
    .btn-ghost { border: none; border-radius: 10px; padding: 8px 18px; background: linear-gradient(145deg,#ffffff,#EDE9FE); color:#7C3AED; font-weight:600; box-shadow: 4px 4px 10px rgba(124,58,237,0.15), -4px -4px 10px rgba(255,255,255,0.9); }
    .btn-ghost:hover { color:#7C3AED; text-decoration:none; }
    .btn-ghost-sm { border: none; border-radius: 8px; padding: 5px 12px; background: linear-gradient(145deg,#ffffff,#EDE9FE); color:#7C3AED; font-weight:600; font-size:.85rem; }
    .btn-ghost-sm:hover { color:#7C3AED; text-decoration:none; }
    .btn-danger-sm { border: none; border-radius: 8px; padding: 5px 12px; background: linear-gradient(90deg,#EF4444,#FB923C); color:#fff; font-weight:600; font-size:.85rem; }
    .btn-danger-sm:hover { color:#fff; }
</style>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1 title-grad"><i class="bi bi-person-badge me-2"></i>Customers</h2>
            <p class="mb-0" style="color:#64748B;">Manage walk-in / in-store customer records used for POS sales</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Dashboard", "Admin")" class="btn-ghost"><i class="bi bi-arrow-left me-1"></i>Dashboard</a>
            <a href="@Url.Action("Create")" class="btn-glass"><i class="bi bi-plus-lg me-1"></i>Add Customer</a>
        </div>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <div class="glass-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th class="ps-4">Name</th><th>Phone</th><th>Email</th><th>Status</th><th class="text-end pe-4">Actions</th></tr></thead>
                <tbody>
                    @if (!Model.Any()) { <tr><td colspan="5" class="text-center py-4" style="color:#64748B;">No customers yet.</td></tr> }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold" style="color:#24324A;">@item.Name</td>
                            <td style="color:#64748B;">@(string.IsNullOrEmpty(item.Phone) ? "-" : item.Phone)</td>
                            <td style="color:#64748B;">@(string.IsNullOrEmpty(item.Email) ? "-" : item.Email)</td>
                            <td>
                                @if (item.IsActive) { <span class="badge bg-success">Active</span> }
                                else { <span class="badge bg-secondary">Inactive</span> }
                            </td>
                            <td class="text-end pe-4">
                                <a href="@Url.Action("Edit", new { id = item.CustomerId })" class="btn-ghost-sm"><i class="bi bi-pencil"></i> Edit</a>
                                @using (Html.BeginForm("Delete", "Customer", new { id = item.CustomerId }, FormMethod.Post, new { style = "display:inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-danger-sm" onclick="return confirm('Delete this customer?');"><i class="bi bi-trash3"></i> Delete</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
