@{
    ViewBag.Title = "Access Denied";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="glass-card p-4 p-md-5 text-center">
                <div class="mb-3" style="font-size:3rem;color:#EF4444;">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h1 class="h3 fw-bold mb-2">Access denied</h1>
                <p class="text-muted mb-4">Your account does not have permission to open this section.</p>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                        <i class="bi bi-house me-1"></i>Back to Shop
                    </a>
                    <a href="@Url.Action("Profile", "Account")" class="btn btn-outline-secondary">
                        <i class="bi bi-person-circle me-1"></i>My Profile
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
