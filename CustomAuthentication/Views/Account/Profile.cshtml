@model CustomAuthentication.ViewModel.ProfileViewModel

@{
    ViewBag.Title = "My Profile";
}

<style>
    .pf-glass {
        background: rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.6);
        border-radius: 22px;
        box-shadow: 0 8px 32px rgba(160, 108, 255, 0.15);
    }
    .pf-header {
        text-align: center;
        padding: 40px 24px 28px;
    }
    .pf-avatar-wrap {
        position: relative;
        width: 120px;
        height: 120px;
        margin: 0 auto 16px;
    }
    .pf-avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 8px 24px rgba(124,58,237,0.3);
        border: 4px solid #fff;
    }
    .pf-avatar-placeholder {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(145deg, #ffffff, #EDE9FE);
        box-shadow: 0 8px 24px rgba(124,58,237,0.25);
        border: 4px solid #fff;
        font-size: 2.6rem;
        font-weight: 700;
        color: #7C3AED;
    }
    .pf-avatar-edit {
        position: absolute;
        bottom: 4px;
        right: 4px;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: none;
        background: linear-gradient(90deg, #3B82F6, #7C3AED);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 3px 3px 10px rgba(124,58,237,0.35);
        cursor: pointer;
    }
    .pf-avatar-edit:hover { opacity: .9; }
    .pf-name {
        font-weight: 800;
        font-size: 1.6rem;
        background: linear-gradient(90deg, #3B82F6, #7C3AED);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 2px;
    }
    .pf-role-badge {
        display: inline-block;
        padding: 5px 16px;
        border-radius: 30px;
        background: linear-gradient(90deg, #3B82F6, #7C3AED);
        color: #fff;
        font-weight: 600;
        font-size: .8rem;
        letter-spacing: .3px;
    }
    .pf-row {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 24px;
        border-bottom: 1px solid rgba(124,58,237,0.12);
    }
    .pf-row:last-child { border-bottom: none; }
    .pf-icon-circle {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: linear-gradient(145deg,#ffffff,#EDE9FE);
        box-shadow: 3px 3px 8px rgba(124,58,237,0.15), -3px -3px 8px rgba(255,255,255,0.9);
        color: #7C3AED;
        font-size: 1.2rem;
    }
    .pf-label { color: #64748B; font-size: .78rem; display: block; }
    .pf-value { color: #24324A; font-weight: 600; }
    .pf-btn {
        border: none;
        border-radius: 12px;
        padding: 10px 22px;
        background: linear-gradient(90deg, #3B82F6, #7C3AED);
        color: #fff;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        box-shadow: 4px 4px 10px rgba(124,58,237,0.25);
    }
    .pf-btn:hover { color: #fff; opacity: .92; text-decoration: none; }
    .pf-btn-ghost {
        border: none;
        border-radius: 12px;
        padding: 10px 22px;
        background: linear-gradient(145deg,#ffffff,#EDE9FE);
        color: #7C3AED;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        box-shadow: 4px 4px 10px rgba(124,58,237,0.15), -4px -4px 10px rgba(255,255,255,0.9);
    }
    .pf-btn-ghost:hover { color: #7C3AED; text-decoration: none; }
</style>

<div class="container py-5">

    @if (TempData["Success"] != null)
    {
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        </div>
    }

    <div class="row justify-content-center">

        <div class="col-lg-7 col-md-9 col-sm-12">

            <div class="pf-glass overflow-hidden">

                <!-- Header -->
                <div class="pf-header">

                    <div class="pf-avatar-wrap">

                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <img src="@Url.Content(Model.ImagePath)" class="pf-avatar" alt="@Model.FullName" />
                        }
                        else
                        {
                            <div class="pf-avatar-placeholder">
                                @Model.FullName.Substring(0, 1).ToUpper()
                            </div>
                        }

                        <button type="button" class="pf-avatar-edit" title="Change photo"
                                onclick="document.getElementById('profileImageInput').click();">
                            <i class="bi bi-camera-fill"></i>
                        </button>
                    </div>

                    @using (Html.BeginForm("UploadProfilePicture", "Account", FormMethod.Post, new { enctype = "multipart/form-data", id = "profileImageForm" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="file" id="profileImageInput" name="profileImage" accept=".jpg,.jpeg,.png,.gif,.webp" style="display:none;" onchange="document.getElementById('profileImageForm').submit();" />
                    }

                    <h2 class="pf-name mb-1">@Model.FullName</h2>
                    <span class="pf-role-badge"><i class="bi bi-briefcase-fill me-1"></i>@Model.RoleName</span>
                </div>


                <!-- Body -->
                <div>

                    <div class="pf-row">
                        <div class="pf-icon-circle"><i class="bi bi-person-fill"></i></div>
                        <div>
                            <span class="pf-label">Full Name</span>
                            <span class="pf-value">@Model.FullName</span>
                        </div>
                    </div>

                    <div class="pf-row">
                        <div class="pf-icon-circle"><i class="bi bi-envelope-fill"></i></div>
                        <div>
                            <span class="pf-label">Email Address</span>
                            <span class="pf-value">@Model.Email</span>
                        </div>
                    </div>

                    <div class="pf-row">
                        <div class="pf-icon-circle"><i class="bi bi-shield-check"></i></div>
                        <div>
                            <span class="pf-label">Designation / Post</span>
                            <span class="pf-value">@Model.RoleName</span>
                        </div>
                    </div>

                    <div class="pf-row">
                        <div class="pf-icon-circle"><i class="bi bi-person-check-fill"></i></div>
                        <div>
                            <span class="pf-label d-block mb-1">Account Status</span>
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success px-3 py-2">
                                    <i class="bi bi-check-circle-fill me-1"></i>Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger px-3 py-2">
                                    <i class="bi bi-x-circle-fill me-1"></i>Inactive
                                </span>
                            }
                        </div>
                    </div>

                </div>


                <!-- Buttons -->
                <div class="d-flex justify-content-center gap-2 py-4">

                    <a href="@Url.Action("Index", "Home")" class="pf-btn-ghost">
                        <i class="bi bi-house-fill me-1"></i> Home
                    </a>

                    <a href="@Url.Action("LogOut", "Account")" class="pf-btn">
                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
