@model CustomAuthentication.ViewModel.RegisterViewModel

@{
    ViewBag.Title = "Register";
}

<style>
    .rg-glass {
        background: rgba(255,255,255,0.55);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255,255,255,0.6);
        border-radius: 22px;
        box-shadow: 0 8px 32px rgba(124,58,237,0.15);
    }
    .rg-header {
        text-align: center;
        padding: 34px 24px 26px;
    }
    .rg-icon-circle {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        margin: 0 auto 12px;
        display: flex; align-items: center; justify-content: center;
        background: linear-gradient(90deg,#3B82F6,#7C3AED);
        color: #fff;
        font-size: 1.8rem;
        box-shadow: 0 8px 20px rgba(124,58,237,0.3);
    }
    .rg-title-grad {
        background: linear-gradient(90deg,#3B82F6,#7C3AED);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .rg-form-control, .rg-form-control:focus {
        background: rgba(255,255,255,0.7);
        border: 1px solid rgba(124,58,237,0.25);
        box-shadow: none;
    }
    .rg-form-control:focus {
        border-color: #7C3AED;
        box-shadow: 0 0 0 0.2rem rgba(124,58,237,0.15);
    }
    .rg-input-icon {
        background: rgba(255,255,255,0.6);
        border: 1px solid rgba(124,58,237,0.25);
        border-right: none;
        color: #7C3AED;
    }
    .rg-btn {
        border: none; border-radius: 12px; padding: 12px;
        background: linear-gradient(90deg,#3B82F6,#7C3AED); color:#fff; font-weight:700;
        box-shadow: 4px 4px 12px rgba(124,58,237,0.3);
    }
    .rg-btn:hover { color:#fff; opacity:.92; }
    .rg-btn-ghost {
        border: none; border-radius: 12px; padding: 10px 22px;
        background: linear-gradient(145deg,#ffffff,#EDE9FE); color:#7C3AED; font-weight:600;
        box-shadow: 4px 4px 10px rgba(124,58,237,0.15), -4px -4px 10px rgba(255,255,255,0.9);
    }
    .rg-btn-ghost:hover { color:#7C3AED; text-decoration:none; }
    .rg-back { color:#64748B; text-decoration:none; }
    .rg-back:hover { color:#7C3AED; }
</style>

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-6 col-md-8 col-sm-12">

            <!-- Back to Home -->
            <div class="mb-3">
                <a href="@Url.Action("Index", "Home")" class="rg-back">
                    <i class="bi bi-arrow-left me-1"></i> Back to Home
                </a>
            </div>

            <!-- Register Card -->
            <div class="rg-glass overflow-hidden">

                <!-- Header -->
                <div class="rg-header">
                    <div class="rg-icon-circle">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>

                    <h2 class="fw-bold mb-1 rg-title-grad">Create Account</h2>
                    <p class="mb-0" style="color:#64748B;">Register a new account</p>
                </div>


                <!-- Body -->
                <div class="p-4 p-md-5 pt-0">

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(
                            true,
                            "",
                            new { @class = "alert alert-danger" }
                        )


                        <!-- Full Name -->
                        <div class="mb-3">
                            @Html.LabelFor(m => m.FullName, new { @class = "form-label fw-semibold", style = "color:#24324A;" })

                            <div class="input-group">
                                <span class="input-group-text rg-input-icon"><i class="bi bi-person-fill"></i></span>
                                @Html.TextBoxFor(m => m.FullName, new { @class = "form-control rg-form-control", placeholder = "Enter your full name" })
                            </div>

                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                        </div>


                        <!-- Phone -->
                        <div class="mb-3">
                            @Html.LabelFor(m => m.Phone, new { @class = "form-label fw-semibold", style = "color:#24324A;" })

                            <div class="input-group">
                                <span class="input-group-text rg-input-icon"><i class="bi bi-telephone-fill"></i></span>
                                @Html.TextBoxFor(m => m.Phone, new { @class = "form-control rg-form-control", placeholder = "Enter your phone number" })
                            </div>

                            @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger small" })
                        </div>


                        <!-- Email -->
                        <div class="mb-3">
                            @Html.LabelFor(m => m.Email, new { @class = "form-label fw-semibold", style = "color:#24324A;" })

                            <div class="input-group">
                                <span class="input-group-text rg-input-icon"><i class="bi bi-envelope-fill"></i></span>
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control rg-form-control", type = "email", placeholder = "Enter your email" })
                            </div>

                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>


                        <!-- Password -->
                        <div class="mb-3">
                            @Html.LabelFor(m => m.Password, new { @class = "form-label fw-semibold", style = "color:#24324A;" })

                            <div class="input-group">
                                <span class="input-group-text rg-input-icon"><i class="bi bi-lock-fill"></i></span>
                                @Html.PasswordFor(m => m.Password, new { @class = "form-control rg-form-control", placeholder = "Enter your password" })
                            </div>

                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                        </div>


                        <!-- Confirm Password -->
                        <div class="mb-4">
                            @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label fw-semibold", style = "color:#24324A;" })

                            <div class="input-group">
                                <span class="input-group-text rg-input-icon"><i class="bi bi-shield-lock-fill"></i></span>
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control rg-form-control", placeholder = "Confirm your password" })
                            </div>

                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                        </div>


                        <!-- Register Button -->
                        <div class="d-grid mb-3">
                            <button type="submit" class="rg-btn">
                                <i class="bi bi-person-plus-fill me-2"></i> Register
                            </button>
                        </div>

                    }


                    <!-- Login Button -->
                    <div class="text-center mt-3">
                        <p class="mb-2" style="color:#64748B;">Already have an account?</p>

                        <a href="@Url.Action("Login", "Account")" class="rg-btn-ghost">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Login
                        </a>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
