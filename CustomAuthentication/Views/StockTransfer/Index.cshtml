@model IEnumerable<CustomAuthentication.Models.StockTransfer>
@{ ViewBag.Title = "Stock Transfers"; }
<style>
.glass-card{background:rgba(255,255,255,.55);backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.6);border-radius:20px;box-shadow:0 8px 32px rgba(124,58,237,.15);}
.title-grad{background:linear-gradient(90deg,#3B82F6,#7C3AED);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.btn-glass{border:none;border-radius:10px;padding:8px 18px;background:linear-gradient(90deg,#3B82F6,#7C3AED);color:#fff;font-weight:600;}
.btn-ghost{border:none;border-radius:10px;padding:8px 18px;background:linear-gradient(145deg,#ffffff,#EDE9FE);color:#7C3AED;font-weight:600;}
.btn-ghost:hover{color:#7C3AED;text-decoration:none;}
.btn-ghost-sm{border:none;border-radius:8px;padding:5px 12px;background:linear-gradient(145deg,#ffffff,#EDE9FE);color:#7C3AED;font-weight:600;font-size:.85rem;}
</style>
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h2 class="fw-bold mb-1 title-grad"><i class="bi bi-arrow-left-right me-2"></i>Stock Transfers</h2><p class="mb-0" style="color:#64748B;">Move stock between warehouses</p></div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Dashboard","Admin")" class="btn-ghost"><i class="bi bi-arrow-left me-1"></i>Dashboard</a>
            <a href="@Url.Action("Create")" class="btn-glass"><i class="bi bi-plus-lg me-1"></i>Request Transfer</a>
        </div>
    </div>
    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
    <div class="glass-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th class="ps-4">Transfer #</th><th>From</th><th>To</th><th>Date</th><th>Status</th><th class="text-end pe-4">Actions</th></tr></thead>
                <tbody>
                @if (!Model.Any()) { <tr><td colspan="6" class="text-center py-4" style="color:#64748B;">No transfers yet.</td></tr> }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-semibold" style="color:#24324A;">@item.TransferNumber</td>
                        <td style="color:#64748B;">@(item.FromWarehouse?.Name ?? "-")</td>
                        <td style="color:#64748B;">@(item.ToWarehouse?.Name ?? "-")</td>
                        <td style="color:#64748B;">@item.TransferDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (item.Status == "Received") { <span class="badge bg-success">Received</span> }
                            else if (item.Status == "Sent") { <span class="badge" style="background:#7C3AED;color:#fff;">Sent</span> }
                            else if (item.Status == "Approved") { <span class="badge bg-info text-dark">Approved</span> }
                            else if (item.Status == "Rejected" || item.Status == "Cancelled") { <span class="badge bg-danger">@item.Status</span> }
                            else { <span class="badge bg-warning text-dark">Requested</span> }
                        </td>
                        <td class="text-end pe-4"><a href="@Url.Action("Details", new { id = item.StockTransferId })" class="btn-ghost-sm"><i class="bi bi-eye"></i> View</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
