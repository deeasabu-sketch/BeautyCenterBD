@model IEnumerable<CustomAuthentication.Models.Sale>
@{ ViewBag.Title = "Sales"; }
<style>
.glass-card{background:rgba(255,255,255,.55);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.6);border-radius:20px;box-shadow:0 8px 32px rgba(124,58,237,.15);}
.title-grad{background:linear-gradient(90deg,#3B82F6,#7C3AED);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.btn-glass{border:none;border-radius:10px;padding:8px 18px;background:linear-gradient(90deg,#3B82F6,#7C3AED);color:#fff;font-weight:600;}
.btn-glass:hover{color:#fff;text-decoration:none;opacity:.92}
.btn-ghost{border:none;border-radius:10px;padding:8px 18px;background:linear-gradient(145deg,#ffffff,#EDE9FE);color:#7C3AED;font-weight:600;}
.btn-ghost:hover{color:#7C3AED;text-decoration:none;}
.btn-ghost-sm{border:none;border-radius:8px;padding:5px 12px;background:linear-gradient(145deg,#ffffff,#EDE9FE);color:#7C3AED;font-weight:600;font-size:.85rem;}
</style>
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h2 class="fw-bold mb-1 title-grad"><i class="bi bi-cash-coin me-2"></i>Sales (POS)</h2><p class="mb-0" style="color:#64748B;">In-store sales</p></div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Dashboard","Admin")" class="btn-ghost"><i class="bi bi-arrow-left me-1"></i>Dashboard</a>
            <a href="@Url.Action("Create")" class="btn-glass"><i class="bi bi-plus-lg me-1"></i>New Sale</a>
        </div>
    </div>
    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
    <div class="glass-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th class="ps-4">Sale #</th><th>Customer</th><th>Warehouse</th><th>Date</th><th>Total</th><th>Status</th><th class="text-end pe-4">Actions</th></tr></thead>
                <tbody>
                @if (!Model.Any()) { <tr><td colspan="7" class="text-center py-4" style="color:#64748B;">No sales yet.</td></tr> }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-semibold" style="color:#24324A;">@item.SaleNumber</td>
                        <td style="color:#64748B;">@(item.Customer?.Name ?? "Walk-in")</td>
                        <td style="color:#64748B;">@(item.Warehouse?.Name ?? "-")</td>
                        <td style="color:#64748B;">@item.SaleDate.ToString("dd MMM yyyy")</td>
                        <td style="color:#24324A;" class="fw-semibold">Taka @item.TotalAmount.ToString("N2")</td>
                        <td>
                            @if (item.Status == "Completed") { <span class="badge bg-success">Completed</span> }
                            else if (item.Status == "Cancelled") { <span class="badge bg-danger">Cancelled</span> }
                            else { <span class="badge bg-warning text-dark">@item.Status</span> }
                        </td>
                        <td class="text-end pe-4"><a href="@Url.Action("Details", new { id = item.SaleId })" class="btn-ghost-sm"><i class="bi bi-eye"></i> View</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
