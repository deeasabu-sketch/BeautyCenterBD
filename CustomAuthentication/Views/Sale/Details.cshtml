@model CustomAuthentication.Models.Sale
@{ ViewBag.Title = "Sale Details"; }
<style>
.glass-card{background:rgba(255,255,255,.55);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.6);border-radius:20px;box-shadow:0 8px 32px rgba(124,58,237,.15);}
.title-grad{background:linear-gradient(90deg,#3B82F6,#7C3AED);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.btn-ghost{border:none;border-radius:10px;padding:8px 18px;background:linear-gradient(145deg,#ffffff,#EDE9FE);color:#7C3AED;font-weight:600;}
.btn-ghost:hover{color:#7C3AED;text-decoration:none;}
.btn-danger{border:none;border-radius:10px;padding:8px 18px;background:linear-gradient(90deg,#EF4444,#FB923C);color:#fff;font-weight:600;}
.lbl{color:#64748B;font-size:.8rem;} .val{color:#24324A;font-weight:600;}
</style>
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h2 class="fw-bold mb-1 title-grad"><i class="bi bi-receipt me-2"></i>@Model.SaleNumber</h2></div>
        <a href="@Url.Action("Index")" class="btn-ghost"><i class="bi bi-arrow-left me-1"></i>Back to Sales</a>
    </div>
    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
    <div class="glass-card p-4 mb-4">
        <div class="row g-3">
            <div class="col-md-3"><span class="lbl d-block">Customer</span><span class="val">@(Model.Customer?.Name ?? "Walk-in")</span></div>
            <div class="col-md-3"><span class="lbl d-block">Warehouse</span><span class="val">@(Model.Warehouse?.Name ?? "-")</span></div>
            <div class="col-md-3"><span class="lbl d-block">Date</span><span class="val">@Model.SaleDate.ToString("dd MMM yyyy, hh:mm tt")</span></div>
            <div class="col-md-3"><span class="lbl d-block">Status</span>
                @if (Model.Status == "Completed") { <span class="badge bg-success">Completed</span> }
                else if (Model.Status == "Cancelled") { <span class="badge bg-danger">Cancelled</span> }
                else { <span class="badge bg-warning text-dark">@Model.Status</span> }
            </div>
        </div>
    </div>
    <div class="glass-card mb-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th class="ps-4">Product</th><th>Qty</th><th>Unit Price</th><th class="text-end pe-4">Line Total</th></tr></thead>
                <tbody>
                @foreach (var d in Model.SaleDetails)
                {
                    <tr><td class="ps-4 val">@(d.Product?.ProductName ?? "-")</td><td style="color:#64748B;">@d.Quantity</td><td style="color:#64748B;">Taka @d.UnitPrice.ToString("N2")</td><td class="text-end pe-4 val">Taka @d.LineTotal.ToString("N2")</td></tr>
                }
                </tbody>
                <tfoot>
                    <tr><td colspan="3" class="text-end ps-4 lbl">Subtotal</td><td class="text-end pe-4 val">Taka @Model.SubTotal.ToString("N2")</td></tr>
                    <tr><td colspan="3" class="text-end lbl">Discount</td><td class="text-end pe-4 val">- Taka @Model.Discount.ToString("N2")</td></tr>
                    <tr><td colspan="3" class="text-end lbl">Tax</td><td class="text-end pe-4 val">+ Taka @Model.Tax.ToString("N2")</td></tr>
                    <tr><td colspan="3" class="text-end fw-bold" style="color:#24324A;">Total</td><td class="text-end pe-4 fw-bold title-grad">Taka @Model.TotalAmount.ToString("N2")</td></tr>
                </tfoot>
            </table>
        </div>
    </div>
    @if (Model.Status != "Cancelled")
    {
        using (Html.BeginForm("Cancel", "Sale", new { id = Model.SaleId }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-danger" onclick="return confirm('Cancel this sale? Stock will be restored.');"><i class="bi bi-x-circle me-1"></i>Cancel Sale</button>
        }
    }
</div>
