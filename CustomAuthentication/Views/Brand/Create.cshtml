@model CustomAuthentication.Models.Brand

@{
    ViewBag.Title = "Add Brand";
}

<style>
    .glass-card { background: rgba(255,255,255,0.55); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border: 1px solid rgba(255,255,255,0.6); border-radius: 20px; box-shadow: 0 8px 32px rgba(124,58,237,0.15); }
    .title-grad { background: linear-gradient(90deg,#3B82F6,#7C3AED); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .frm-control, .frm-control:focus { background: rgba(255,255,255,0.7); border: 1px solid rgba(124,58,237,0.25); box-shadow: none; }
    .frm-control:focus { border-color: #7C3AED; box-shadow: 0 0 0 0.2rem rgba(124,58,237,0.15); }
    .lbl { color: #24324A; font-weight: 600; }
    .btn-glass { border: none; border-radius: 10px; padding: 10px 22px; background: linear-gradient(90deg,#3B82F6,#7C3AED); color:#fff; font-weight:600; box-shadow: 4px 4px 10px rgba(124,58,237,0.25); }
    .btn-glass:hover { color:#fff; opacity:.92; }
    .btn-ghost {
        border: none;
        border-radius: 10px;
        padding: 10px 22px;
        background: linear-gradient(145deg,#7C3AED,#C4B5FD);
        color: #182346;
        font-weight: 600;
        box-shadow: 4px 4px 10px rgba(124,58,237,0.15), -4px -4px 10px rgba(255,255,255,0.9);
    }

        .btn-ghost:hover {
            color: #CAE5BC;
            text-decoration: none;
        }
    .upload-box { border: 2px dashed rgba(124,58,237,0.35); border-radius: 16px; padding: 18px; background: rgba(255,255,255,0.4); text-align: center; }
    .img-preview { max-width: 180px; max-height: 180px; object-fit: contain; border-radius: 14px; box-shadow: 0 6px 18px rgba(124,58,237,0.2); margin-top: 12px; background:#fff; }
</style>

<div class="container py-5">
    @Html.Partial("_BackBar", new List<CustomAuthentication.ViewModel.BackBarLink>
    {
        new CustomAuthentication.ViewModel.BackBarLink("Dashboard", "Admin", "Dashboard"),
        new CustomAuthentication.ViewModel.BackBarLink("Brands", "Brand", "Index")
    })
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="glass-card p-4 p-md-5">
                <h3 class="fw-bold title-grad mb-4"><i class="bi bi-award me-2"></i>Add Brand</h3>

                @using (Html.BeginForm("Create", "Brand", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Name, new { @class = "form-label lbl" })
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control frm-control" })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Description, new { @class = "form-label lbl" })
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control frm-control", rows = "3" })
                    </div>

                    <div class="mb-4">
                        <label class="form-label lbl">Brand Logo</label>
                        <div class="upload-box">
                            <i class="bi bi-cloud-arrow-up" style="font-size:1.6rem;color:#7C3AED;"></i>
                            <input type="file" name="brandImage" id="brandImage" class="form-control frm-control mt-2" accept=".jpg,.jpeg,.png,.gif,.webp" />
                            <small style="color:#64748B;">JPG, PNG, GIF, WEBP - max 5 MB</small>
                            <div><img id="imgPreview" src="#" class="img-preview" style="display:none;" /></div>
                        </div>
                    </div>

                    <div class="form-check form-switch mb-4">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                        @Html.LabelFor(m => m.IsActive, "Active", new { @class = "form-check-label" })
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="@Url.Action("Index","Brand")" class="btn-ghost">Available Brand</a>
                        <a href="@Url.Action("Index")" class="btn-ghost">Cancel</a>
                        <button type="submit" class="btn-glass"><i class="bi bi-check-circle me-1"></i>Save</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("brandImage").addEventListener("change", function (e) {
            var file = e.target.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function (ev) {
                    var img = document.getElementById("imgPreview");
                    img.src = ev.target.result;
                    img.style.display = "block";
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}
